#!/usr/bin/env bash
set -euo pipefail

# Canonical task-done (#236, epic #122 Phase 2).
#
# Was a dispatcher that exec'd $AW_ROOT/<impl>/bin/task-done. Those seven copies
# were a three-variant file: claude-gh == claude-notion == kiro-gh ==
# kiro-notion byte-identical, claude-local == kiro-local byte-identical, and
# claude-jira differing by seven lines. 1525 lines expressing ~249 distinct
# ones, held in step by ten groups in tools/check-drift.sh — and the one part
# that genuinely differed per tracker (the PR section) was the one part with no
# sentinel on it.
#
# There is no agent axis here at all: removing a worktree, sweeping radio state
# and closing a tab does not depend on which agent was sitting in the tab. So
# this composes one tracker module and nothing else. The agent modules are
# bin/task-work's other axis (#237); nothing here reads them.

# Resolve own path through symlinks -> AW_ROOT.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src != /* ]] && src="$dir/$src"
done
BIN_DIR=$(cd -P "$(dirname "$src")" && pwd)
AW_ROOT=$(dirname "$BIN_DIR")

# shellcheck source=lib/detect-impl.sh
source "$AW_ROOT/lib/detect-impl.sh"
# shellcheck source=lib/zellij-tab.sh
source "$AW_ROOT/lib/zellij-tab.sh"
# shellcheck source=lib/worktree-procs.sh
source "$AW_ROOT/lib/worktree-procs.sh"

aw_parse_impl_flag "$@" || exit 1

# A worktree removed out from under its worker (#271). `gh pr merge
# --delete-branch` (gh 2.101) deletes the local branch too, and when a worktree
# has that branch checked out gh removes the worktree with it — so the worker
# drains `approved-and-merged` sitting in a directory that no longer exists.
# Every git call below fails there, and the cleanup that matters most (tab,
# radio session, mailbox, sidecar) never ran. The path itself still says
# everything: task-work puts a worktree at <parent>/<repo>-worktrees/<slug>
# and the main checkout at <parent>/<repo>. So step into the main checkout
# and clean up what is left, rather than refusing.
VANISHED_WT=""
if [[ ! -d "$PWD" ]]; then
  _gone="$PWD"
  _wt_base=$(dirname "$_gone")
  _wt_base_name=${_wt_base##*/}
  _main_guess="$(dirname "$_wt_base")/${_wt_base_name%-worktrees}"
  if [[ "$_wt_base_name" == ?*-worktrees ]] && cd "$_main_guess" 2>/dev/null \
     && git rev-parse --git-dir >/dev/null 2>&1; then
    VANISHED_WT="$_gone"
  else
    echo "Error: the current directory $_gone no longer exists, and it is not a task-work worktree (<repo>-worktrees/<slug>) whose main checkout could be found."
    exit 1
  fi
fi

# task-done runs from a worktree where the workflow doc lives in the MAIN
# worktree, not the current (task) worktree. Fall back to inspecting the main
# worktree if auto-detection from $PWD yields zero matches.
if [[ -z "$AW_PARSED_IMPL" && -z "${AW_IMPL:-}" ]]; then
  CURR_REPO=$(git rev-parse --show-toplevel 2>/dev/null) || CURR_REPO=""
  if [[ -n "$CURR_REPO" ]]; then
    MAIN_WT=$(git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //')
    # If we're in a non-main worktree, retry detection from the main worktree.
    if [[ -n "$MAIN_WT" && "$MAIN_WT" != "$CURR_REPO" ]]; then
      pushd "$MAIN_WT" >/dev/null
      IMPL=$(aw_detect_impl "") || { popd >/dev/null; exit 1; }
      popd >/dev/null
    else
      IMPL=$(aw_detect_impl "") || exit 1
    fi
  else
    IMPL=$(aw_detect_impl "") || exit 1
  fi
else
  IMPL=$(aw_detect_impl "$AW_PARSED_IMPL") || exit 1
fi

# Compose the loadout. _default.sh carries the behaviour four of the seven
# copies actually had; the tracker module overrides only what it needs, which is
# why gh.sh and notion.sh override nothing here instead of restating an
# identical PR section.
TRACKER="${IMPL##*-}"
# shellcheck source=lib/trackers/_default.sh
source "$AW_ROOT/lib/trackers/_default.sh"
# Resolve first, source second. `source "$(aw_tracker_module …)" || exit 1` reads
# as equivalent and is not: on a missing module the helper writes its message to
# stderr and exits 1, but the command substitution has already yielded the empty
# string, so `source ""` runs anyway and bash appends its own
# `task-done: line N: : No such file or directory` before `|| exit 1` is ever
# reached. The real diagnosis arrives first and is then followed by shell noise
# about a filename nobody typed, pointing at a line in this script.
TRACKER_MODULE=$(aw_tracker_module "$AW_ROOT" "$TRACKER") || exit 1
# shellcheck source=/dev/null
source "$TRACKER_MODULE"

set -- ${AW_REMAINING_ARGS[@]+"${AW_REMAINING_ARGS[@]}"}

usage() {
  echo "Usage: task-done [--force] [--remove-worktree]"
  echo ""
  echo "Run from within a worktree to:"
  aw_tracker_usage_steps
  echo ""
  echo "Options:"
  echo "  --force            Skip confirmation prompts"
  echo "  --remove-worktree  Skip PR section — just clean up the worktree and tab."
  echo "                     Use after the worker has already created the PR."
  exit 1
}

FORCE=false
REMOVE_ONLY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE=true; shift ;;
    --remove-worktree) REMOVE_ONLY=true; shift ;;
    -h|--help) usage ;;
    *) echo "Unknown option: $1"; usage ;;
  esac
done

# Detect worktree context
WORKTREE_DIR=$(pwd)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Error: not in a git repo"; exit 1; }

MAIN_WORKTREE=$(git worktree list --porcelain | head -1 | sed 's/worktree //')
REPO_NAME=$(basename "$MAIN_WORKTREE")
WORKTREE_BASE="${MAIN_WORKTREE}/../${REPO_NAME}-worktrees"

# Check we're actually in a worktree (not the main repo). One exception (#271):
# a worker whose worktree vanished may have been dropped back into the main
# checkout — an agent harness resets a shell whose cwd is gone — so if this
# session's own role names a worktree that no longer exists but left its
# sidecar or registration behind, clean that one up from here.
if [[ -z "$VANISHED_WT" && "$REPO_ROOT" == "$MAIN_WORKTREE" ]]; then
  _role_slug=""
  case "${TASK_FORCE_ROLE:-}" in
    worker-"$REPO_NAME"-?*) _role_slug=${TASK_FORCE_ROLE#worker-"$REPO_NAME"-} ;;
    reviewer-"$REPO_NAME"-pr?*) _role_slug=review-${TASK_FORCE_ROLE#reviewer-"$REPO_NAME"-} ;;
  esac
  if [[ -n "$_role_slug" && ! -d "$WORKTREE_BASE/$_role_slug" ]] \
     && { [[ -f "$WORKTREE_BASE/.$_role_slug.info" ]] \
          || grep -q "^worktree .*/${REPO_NAME}-worktrees/${_role_slug}\$" <<<"$(git worktree list --porcelain)"; }; then
    VANISHED_WT="$WORKTREE_BASE/$_role_slug"
  else
    echo "Error: you're in the main repo, not a worktree. cd into a worktree first."
    exit 1
  fi
fi

if [[ -n "$VANISHED_WT" ]]; then
  WORKTREE_DIR="$VANISHED_WT"
  SLUG="${VANISHED_WT##*/}"
  BRANCH="task/${SLUG}"
else
  BRANCH=$(git rev-parse --abbrev-ref HEAD)
  SLUG="${BRANCH#task/}"
fi
INFO_FILE="${WORKTREE_BASE}/.${SLUG}.info"

# Load base branch written by task-work; fall back to "main"
BASE_BRANCH="main"
# Zero PR_NUMBER before sourcing $INFO_FILE so an ambient shell export
# (e.g., from an earlier task-reviewer in the same shell) can't sneak
# into the reviewer-branch force-delete guard below and -D a worker
# branch with unmerged commits (#148 review).
PR_NUMBER=
# shellcheck source=/dev/null
[[ -f "$INFO_FILE" ]] && source "$INFO_FILE"

echo "Worktree: $WORKTREE_DIR"
echo "Branch:   $BRANCH"
echo "Base:     $BASE_BRANCH"
echo ""

if [[ -n "$VANISHED_WT" ]]; then
  # Nothing to diff or summarise: the files are gone, and so (usually) is the
  # local branch. Say why, so a reader does not take the missing summary for a
  # task-done bug.
  echo "⚠ This worktree no longer exists — most likely a 'gh pr merge --delete-branch' removed it"
  echo "  along with the local branch (#271). Cleaning up what is left: radio session, mailbox,"
  echo "  sidecar, worktree registration, tab."
  echo ""
fi

# Check for uncommitted changes
if [[ -z "$VANISHED_WT" ]] && { ! git diff --quiet || ! git diff --cached --quiet; }; then
  echo "⚠ Uncommitted changes detected:"
  git status --short
  echo ""
  if [[ "$FORCE" != true ]]; then
    read -rp "Continue anyway? (y/N) " confirm
    [[ "$confirm" != "y" && "$confirm" != "Y" ]] && exit 1
  fi
fi

# Show summary
if [[ -z "$VANISHED_WT" ]]; then
  COMMIT_COUNT=$(git rev-list --count "${BASE_BRANCH}..HEAD" 2>/dev/null || echo "?")
  echo "Commits ahead of ${BASE_BRANCH}: $COMMIT_COUNT"
  DIFF_STAT=$(git diff --shortstat "${BASE_BRANCH}..HEAD" 2>/dev/null || true)
  [[ -n "$DIFF_STAT" ]] && echo "Changes: $DIFF_STAT"
  echo ""
fi

if [[ "$REMOVE_ONLY" != true && -z "$VANISHED_WT" ]]; then
  # Show existing PR URL, or print the creation command. Every tracker shells
  # out to `gh` here — the PR lives on the forge whatever the spec is tracked
  # in — so only the --title differs, and only on jira.
  aw_tracker_pr_section "$BASE_BRANCH" "$BRANCH" "$SLUG"
  echo ""
fi

if [[ "$FORCE" != true && "$REMOVE_ONLY" != true ]]; then
  read -rp "Remove worktree and close tab? (y/N) " confirm
  [[ "$confirm" != "y" && "$confirm" != "Y" ]] && exit 0
fi

# Capture this worker's stable zellij tab_id BEFORE `radio unregister`
# removes the session file. We use it at the end of cleanup to close
# *this* worker's tab specifically (`close-tab-by-id`), not the focused
# one. The unscoped `zellij action close-tab` targets whichever tab is
# focused at call time — same focused-tab bug class as #102/#103 in a
# different binary; if the user switches focus mid-cleanup, the wrong tab
# (e.g., PM's) gets closed and an active session can be destroyed (#107).
#
# Preferred source: $INFO_FILE, which task-work writes at tab creation and
# which radio touches only to replace a stale TAB_ID with a live zellij hit
# when a register resolves one (#260). Independent of the radio session
# file's mid-life state, so an in-session SessionStart re-register that
# clobbered the session file's TAB_ID= (#117) can't break cleanup. Fall
# back to the radio session file for workers whose task-work pre-dates the
# $INFO_FILE TAB_ID write.
_WORKER_TAB_ID=""
if [[ -n "${ZELLIJ:-}" && -f "$INFO_FILE" ]]; then
  _WORKER_TAB_ID=$(awk -F= '/^TAB_ID=/ { print $2; exit }' "$INFO_FILE")
fi
if [[ -z "$_WORKER_TAB_ID" && -n "${ZELLIJ:-}" && -n "${TASK_FORCE_ROLE:-}" ]]; then
  _SESSION_FILE="${TASK_FORCE_HOME:-$HOME/.task-force}/radio/sessions/${TASK_FORCE_ROLE}.info"
  if [[ -f "$_SESSION_FILE" ]]; then
    _WORKER_TAB_ID=$(awk -F= '/^TAB_ID=/ { print $2; exit }' "$_SESSION_FILE")
  fi
fi
# Say which source came up empty, decided now: $INFO_FILE is deleted before the
# close-tab step that reports it. A sidecar with no TAB_ID= line is task-work's
# capture failing, which it reports and logs as `tab-id:` at launch (#242).
_TAB_ID_MISS=""
if [[ -z "$_WORKER_TAB_ID" ]]; then
  if [[ -z "${ZELLIJ:-}" ]]; then
    _TAB_ID_MISS="task-done is not running inside zellij (\$ZELLIJ unset)"
  elif [[ ! -f "$INFO_FILE" ]]; then
    _TAB_ID_MISS="no sidecar at $INFO_FILE (branch '$BRANCH')"
  else
    _TAB_ID_MISS="$(basename "$INFO_FILE") has no TAB_ID= line; the launch logged why: grep 'tab-id:.*slug=$SLUG ' ${TASK_FORCE_HOME:-$HOME/.task-force}/radio/log"
  fi
fi

# Unregister radio session before tearing down the worktree (#94). The
# `|| true` is a safety net: $TASK_FORCE_ROLE should be set inside a worker
# tab, but if it isn't (e.g., task-done invoked from an unexpected shell)
# the no-op must not abort cleanup. `radio unregister` itself already
# silently exits when $TASK_FORCE_ROLE is unset (#93).
#
# `--manual` is the explicit opt-in (#187). On hook-shaped stdin `radio
# unregister` now defaults to NOT wiping: an empty payload is byte-identical
# whether it came from deliberate cleanup or a spurious SessionEnd firing, and
# 98.7% of observed wipes were the latter. This call site is real cleanup —
# the worktree and the tab are both about to go — so it declares that instead
# of letting radio infer intent from the shape of its stdin. Keep the
# /dev/null redirect regardless, so the payload read can't swallow whatever
# the calling shell piped in (under `--force` that may be a stray `y`).
radio unregister --manual </dev/null 2>/dev/null || true

# Sweep this worker's radio mailbox (#169). Once the worktree and tab are gone
# the role is dead by definition, so its inbox/processed dirs are pure residue —
# e.g. an `approved-and-merged` ping that landed after the tab closed. Guard the
# role name against empty / traversal so a stray env value can't turn this into
# an `rm -rf` of the whole mailbox root.
_ROLE="${TASK_FORCE_ROLE:-}"
case "$_ROLE" in
  ""|-*|*/*|*..*|*[!a-zA-Z0-9_-]*) : ;;   # unset or unsafe — skip
  *)
    _MAILBOX_DIR="${TASK_FORCE_HOME:-$HOME/.task-force}/radio/mailbox/$_ROLE"
    [[ -d "$_MAILBOX_DIR" ]] && rm -rf "$_MAILBOX_DIR"
    ;;
esac

# Agent processes still running in the worktree (#305), looked for while its
# path still resolves. The agent running this command is not one of them: the
# helper leaves out the caller's own agent tree, which goes with the tab. What
# is left is an agent from an earlier tab that closed without taking it along.
# Warned about, never stopped: whether they are stray is the PM's call. Logged
# as well, because this tab is about to close and take this output with it.
_STRAY_PROCS=$(aw_worktree_agent_procs "$WORKTREE_DIR")
if [[ -n "$_STRAY_PROCS" ]]; then
  _STRAY_PIDS=$(cut -f1 <<<"$_STRAY_PROCS" | tr '\n' ' ')
  echo "⚠ Agent processes are still running in this worktree, and removing it will not stop them:"
  aw_print_worktree_procs "    " "$_STRAY_PROCS"
  echo "  They outlived the tab that started them. Check they are stray, then: kill ${_STRAY_PIDS% }"
  echo ""
  aw_radio_log "stray-procs: task-done left ${_STRAY_PIDS}running in $WORKTREE_DIR slug=$SLUG"
fi

# Move out of worktree before removing it
cd "$MAIN_WORKTREE"

# Remove worktree
if [[ -n "$VANISHED_WT" ]]; then
  # Already gone from disk; drop git's registration of it, if any is left.
  echo "Pruning the vanished worktree's registration..."
  git worktree prune
else
  echo "Removing worktree..."
  # Deinit any submodules first — git refuses to remove a worktree containing them.
  if [[ -f "$WORKTREE_DIR/.gitmodules" ]]; then
    git -C "$WORKTREE_DIR" submodule deinit --all --force >/dev/null 2>&1 || true
  fi
  git worktree remove "$WORKTREE_DIR" --force || {
    echo "Warning: removal failed, falling back to rm + prune"
    rm -rf "$WORKTREE_DIR"
    git worktree prune
  }
fi

# Clean up info file
[[ -f "$INFO_FILE" ]] && rm -f "$INFO_FILE"

# Tracker-local bookkeeping that needs the slug while it is still known: on the
# local loadouts, strike the task off .git/task-force/state.json and re-render
# tasks/_board.md. Fires here, between the info-file removal and the branch
# delete, because that is where it has always fired — and with `|| true`,
# because by this point the worktree and the tab are already gone and there is
# nothing useful left to abort.
aw_tracker_post_cleanup "$MAIN_WORKTREE" "$SLUG" "$IMPL" || true

# Reviewer worktrees write PR_NUMBER into their info file; they're pure
# scaffolding and their branch never merges into main (the PR does — its
# head ref is what landed). Force-delete in that case so a subsequent
# `task-reviewer <N>` re-dispatch isn't blocked by the per-PR branch
# guard (#148). Worker branches keep the safe-delete `-d` so unmerged
# work isn't silently dropped.
if ! git show-ref --verify --quiet "refs/heads/$BRANCH"; then
  # Whoever removed the worktree took the branch with it (#271).
  echo "Done. Local branch '$BRANCH' is already gone."
elif [[ -n "${PR_NUMBER:-}" ]]; then
  if git branch -D "$BRANCH" 2>/dev/null; then
    echo "Done. Deleted reviewer branch '$BRANCH' (-D, scaffold-only)."
  else
    echo "Done. Branch '$BRANCH' could not be deleted — clean up manually: git branch -D $BRANCH"
  fi
else
  if git branch -d "$BRANCH" 2>/dev/null; then
    echo "Done. Deleted local branch '$BRANCH'."
  else
    echo "Done. Branch '$BRANCH' still has unmerged commits — delete manually after PR merge: git branch -D $BRANCH"
  fi
fi

# Close this worker's zellij tab by its stable tab_id, captured before
# `radio unregister` wiped the session file. If we didn't capture an id
# (zellij not running, no role, no session file, or empty TAB_ID=), skip —
# falling back to the unscoped `close-tab` would re-open the bug fixed
# above (#107). The user can close the tab manually in that case.
#
# And confirm the id is still ours before acting on it (#260). A tab id is
# only valid within one zellij server's lifetime: after a restart every TAB_ID
# in every sidecar is stale, and `close-tab-by-id` on a stale id closes
# whichever tab holds that id now — on 2026-10-18 that was a freshly launched
# worker's. task-recreate-worker strips the stale id (#218), but a worker
# resumed in place keeps it. So close only when the tab at that id still bears
# this slug, and refuse otherwise: a tab left open costs a keystroke, closing
# the wrong one kills a session.
if [[ -n "$_WORKER_TAB_ID" ]]; then
  _TAB_NAME_RC=0
  _TAB_NAME_AT_ID=$(aw_zellij_tab_name_by_id "$_WORKER_TAB_ID") || _TAB_NAME_RC=$?
  if [[ "$_TAB_NAME_RC" -ne 0 ]]; then
    # Fails closed either way; name which of the two it was, so "jq is not
    # installed" does not read as "zellij is broken".
    if ! command -v jq >/dev/null 2>&1; then
      _TAB_VERIFY_WHY="jq is not installed, so the zellij tab list cannot be read"
      _TAB_VERIFY_CODE="no-jq"
    else
      _TAB_VERIFY_WHY="zellij action list-tabs --json returned nothing parseable"
      _TAB_VERIFY_CODE="list-tabs unreadable"
    fi
    echo "Skipping zellij close-tab: could not list zellij tabs to confirm tab id=$_WORKER_TAB_ID is '$SLUG'."
    echo "  ($_TAB_VERIFY_WHY.) Close this tab manually."
    aw_radio_log "tab-close: id $_WORKER_TAB_ID unverified ($_TAB_VERIFY_CODE), not closed slug=$SLUG"
  elif [[ -z "$_TAB_NAME_AT_ID" ]]; then
    echo "Skipping zellij close-tab: no tab has id=$_WORKER_TAB_ID any more (zellij restarted?)."
    echo "  Close this tab manually."
    aw_radio_log "tab-close: id $_WORKER_TAB_ID is gone, not $SLUG — not closed"
  elif aw_tab_name_is_slug "$_TAB_NAME_AT_ID" "$SLUG"; then
    echo "Closing zellij tab (id=$_WORKER_TAB_ID)..."
    zellij action close-tab-by-id "$_WORKER_TAB_ID" >/dev/null 2>&1 || true
  else
    echo "⚠ Not closing zellij tab id=$_WORKER_TAB_ID: it is now '$_TAB_NAME_AT_ID', not '$SLUG'."
    echo "  The recorded id is stale — zellij restarted since it was captured. Close this tab manually."
    aw_radio_log "tab-close: id $_WORKER_TAB_ID is now $_TAB_NAME_AT_ID, not $SLUG"
  fi
else
  echo "Skipping zellij close-tab (no tab id captured; close this tab manually if needed)."
  echo "  ($_TAB_ID_MISS)"
fi
