#!/usr/bin/env bash
set -euo pipefail

# task-monitor-queue — the PM's short-term queue: what comes next in this repo
# (#275, epic #272 3/6).
#
# The PM writes it when the user and the PM agree on what comes next, and
# task-monitor-snapshot reads it as the board's "Next" section. Writing it is
# the PM's only board cost, so every write answers with one short line and the
# PM never has to read the file back.
#
# This command owns the queue file's format. The file is
# ${TASK_FORCE_HOME:-~/.task-force}/monitor/<repo>/queue, <repo> being the
# sanitized main-repo name (the same directory the snapshot caches in). One
# tracker ref per line, in order, with an optional one-line note after a tab
# and an optional one-line title after a second tab (#306): `ref`,
# `ref<TAB>note`, `ref<TAB>note<TAB>title` or `ref<TAB><TAB>title`. A line with
# no title is exactly what the format was before titles existed.
# Blank lines and `#` comments are ignored on read and never written.
#
# Refs are compared by key, not by spelling: leading `#`s, a URL's query
# string and fragment, and any URL or path prefix are dropped, so `267`,
# `#267` and .../issues/267 are one item, as are tasks/012-x.md and 012-x.md. That is what lets task-work drop the ref it
# dispatches (`rm --quiet <its ref>`) whatever form the PM queued it in.
#
# It also owns the PM's handoff note (#301), the other thing a PM leaves on the
# board for whoever comes next: ${TASK_FORCE_HOME}/monitor/<repo>/handoff.md, a
# `---` frontmatter block (written_at, role, agent) and then the note as given.
# task-monitor-snapshot reads it, and a fresh PM start prints it under the board
# digest. One note per repo: a write replaces it, and nothing else removes it
# but `handoff clear`.
#
# Must run on /bin/bash 3.2: no associative arrays, no mapfile.

# Resolve own path through symlinks -> AW_ROOT.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src != /* ]] && src="$dir/$src"
done
BIN_DIR=$(cd -P "$(dirname "$src")" && pwd)
AW_ROOT=$(dirname "$BIN_DIR")

# shellcheck source=lib/repo-name.sh
source "$AW_ROOT/lib/repo-name.sh"

usage() {
  cat <<'EOF'
Usage: task-monitor-queue [show]
       task-monitor-queue set <ref>... [--note <ref>=<text>]... [--title <ref>=<text>]...
       task-monitor-queue add <ref>... [--note <ref>=<text>]... [--title <ref>=<text>]...
       task-monitor-queue rm <ref>... [--quiet]
       task-monitor-queue clear
       task-monitor-queue handoff write|show|clear
       (every form also takes --repo DIR)

The PM's short-term queue for this repo: the "Next" section of task-monitor.

  show    print the queue, one item per line (the default)
  set     replace the queue with <ref>... in that order. A ref that was
          already queued keeps its note and title unless --note or --title
          gives a new one
  add     append <ref>... to the end; a ref already queued keeps its place
          and only takes the new note or title, if one is given
  rm      drop <ref>...; a ref that is not queued is ignored
  clear   empty the queue
  handoff the note a PM leaves for the next PM in this repo (#301):
            write  replace it with the note on stdin (5-10 lines)
            show   print it
            clear  remove it
          A fresh PM start prints it under the board digest, with its age,
          and keeps it until the next write replaces it

  --note <ref>=<text>  a one-line note for <ref>, which must be one of the
                       refs given or already queued. An empty text clears it.
                       It splits on the first `=`, so a ref that itself
                       contains `=` cannot take a note
  --title <ref>=<text> the item's short name, shown on the board where the
                       tracker cannot supply one (jira, notion). Same rules
                       as --note: a queued ref, an empty text clears it, and
                       it splits on the first `=`
  --quiet              print nothing on success
  --repo DIR           the repo containing DIR instead of $PWD

A ref is a tracker ref: an issue number, a URL, a Jira key, a task file.
`267`, `#267` and .../issues/267 name the same item; a URL's query string
and fragment are ignored. Put `--` before a ref that starts with `-`.

Writes ${TASK_FORCE_HOME:-~/.task-force}/monitor/<repo>/queue, and the note
to handoff.md beside it.
EOF
  exit "${1:-0}"
}

CMD=show
case "${1:-}" in
  show|set|add|rm|clear|handoff) CMD="$1"; shift ;;
  -h|--help|help) usage 0 ;;
esac

ARGS=()
NOTE_ARGS=()
TITLE_ARGS=()
QUIET=0
REPO_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --note)
      [[ $# -ge 2 ]] || { echo "Error: --note requires <ref>=<text>" >&2; exit 2; }
      [[ "$2" == ?*=* ]] || { echo "Error: --note takes <ref>=<text>, got: $2" >&2; exit 2; }
      NOTE_ARGS+=("$2"); shift 2 ;;
    --title)
      [[ $# -ge 2 ]] || { echo "Error: --title requires <ref>=<text>" >&2; exit 2; }
      [[ "$2" == ?*=* ]] || { echo "Error: --title takes <ref>=<text>, got: $2" >&2; exit 2; }
      TITLE_ARGS+=("$2"); shift 2 ;;
    --quiet) QUIET=1; shift ;;
    --repo)
      [[ $# -ge 2 ]] || { echo "Error: --repo requires a value" >&2; exit 2; }
      REPO_ARG="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    --) shift; ARGS+=("$@"); break ;;
    -*) echo "Error: unknown option: $1" >&2; usage 2 >&2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done

case "$CMD" in
  show|clear)
    [[ ${#ARGS[@]} -eq 0 ]] || { echo "Error: $CMD takes no refs" >&2; exit 2; } ;;
  handoff)
    case "${ARGS[*]-}" in
      write|show|clear) ;;
      *) echo "Error: handoff takes one of write, show or clear" >&2; exit 2 ;;
    esac ;;
  set|add|rm)
    [[ ${#ARGS[@]} -gt 0 ]] || { echo "Error: $CMD needs at least one ref" >&2; exit 2; } ;;
esac
if [[ ${#NOTE_ARGS[@]} -gt 0 && "$CMD" != set && "$CMD" != add ]]; then
  echo "Error: --note goes with set or add" >&2
  exit 2
fi
if [[ ${#TITLE_ARGS[@]} -gt 0 && "$CMD" != set && "$CMD" != add ]]; then
  echo "Error: --title goes with set or add" >&2
  exit 2
fi

ROOT=$(aw_main_repo_root "${REPO_ARG:-$PWD}") \
  || { echo "Error: not in a git repo: ${REPO_ARG:-$PWD}" >&2; exit 1; }
REPO_NAME=$(aw_main_repo_name "$ROOT")
QUEUE="${TASK_FORCE_HOME:-$HOME/.task-force}/monitor/$REPO_NAME/queue"
HANDOFF="$(dirname "$QUEUE")/handoff.md"

# ----- the handoff note -----------------------------------------------------

# Who is writing: the PM role and the agent its session recorded, so the next
# PM reads whether the note came from claude or kiro. Either may be empty.
_handoff_write() {
  local role="pm-$REPO_NAME" sessions agent="" note tmp lines
  sessions="${TASK_FORCE_HOME:-$HOME/.task-force}/radio/sessions"
  agent=$(grep -E '^AGENT=' "$sessions/$role.info" 2>/dev/null | head -1 | cut -d= -f2-) || agent=""
  [[ -n "$agent" ]] || agent=$(head -1 "$sessions/$role.agent" 2>/dev/null) || agent=""
  note=$(cat)
  # grep, not a ${var//pat/rep}: that is what hung bash 3.2 on a long string (#266).
  if ! printf '%s' "$note" | grep -q '[^[:space:]]'; then
    echo "Error: handoff write reads the note on stdin, and it was empty" >&2
    exit 2
  fi
  mkdir -p "$(dirname "$HANDOFF")"
  tmp="$HANDOFF.tmp.$$"
  {
    printf -- '---\nwritten_at: %s\nrole: %s\nagent: %s\n---\n' \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$role" "$agent"
    printf '%s\n' "$note"
  } > "$tmp"
  mv -f "$tmp" "$HANDOFF"
  lines=$(printf '%s\n' "$note" | grep -c .) || lines=0
  [[ "$QUIET" == 1 ]] || echo "handoff: $lines line(s) saved; the next PM start prints them"
}

if [[ "$CMD" == handoff ]]; then
  case "${ARGS[0]}" in
    write) _handoff_write ;;
    show)
      if [[ -s "$HANDOFF" ]]; then cat "$HANDOFF"; else [[ "$QUIET" == 1 ]] || echo "handoff: (none)"; fi ;;
    clear)
      rm -f "$HANDOFF"
      [[ "$QUIET" == 1 ]] || echo "handoff: (none)" ;;
  esac
  exit 0
fi

# ----- helpers --------------------------------------------------------------

# A ref with every leading `#` gone. One would be enough for `#267`, but the
# stored form must never start with `#`: the reader skips such a line as a
# comment, so `##5` kept as `#5` would vanish from the queue.
_strip_hashes() {
  local r="$1"
  while [[ "$r" == '#'* ]]; do r="${r#\#}"; done
  printf '%s' "$r"
}

# The identity a ref is compared by: no leading `#`, no query string or
# fragment, no trailing `/`, and only the last path segment of a URL or a path.
# So a Notion page URL and the same URL with `?pvs=4` are one item.
_key() {
  local k
  k=$(_strip_hashes "$1")
  k="${k%%\?*}"
  k="${k%%#*}"
  k="${k%/}"
  printf '%s' "${k##*/}"
}

# A ref goes on one line before a tab, so it may hold neither whitespace nor
# be empty.
_check_ref() {
  [[ -n "$(_strip_hashes "$1")" ]] || { echo "Error: empty ref" >&2; exit 2; }
  case "$1" in
    *[[:space:]]*) echo "Error: a ref cannot contain whitespace: $1" >&2; exit 2 ;;
  esac
}

# A note or a title is one line: tabs and newlines become spaces.
_clean_note() {
  printf '%s' "$1" | tr '\t\n\r' '   '
}

# The current queue, as parallel arrays.
REFS=()
NOTES=()
TITLES=()
if [[ -f "$QUEUE" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in ''|'#'*) continue ;; esac
    REFS+=("${line%%$'\t'*}")
    rest=""
    [[ "$line" == *$'\t'* ]] && rest="${line#*$'\t'}"
    NOTES+=("${rest%%$'\t'*}")
    if [[ "$rest" == *$'\t'* ]]; then TITLES+=("${rest#*$'\t'}"); else TITLES+=(""); fi
  done < "$QUEUE"
fi

# Index of <ref> in REFS by key, or nothing.
_index_of() {
  local k i
  k=$(_key "$1")
  for ((i = 0; i < ${#REFS[@]}; i++)); do
    if [[ "$(_key "${REFS[$i]}")" == "$k" ]]; then
      printf '%s' "$i"
      return 0
    fi
  done
  return 1
}

# Read-modify-write with no lock: a PM `set` racing task-work's `rm` can lose
# one of the two updates. Accepted: the window is milliseconds, and the PM, the
# only real writer, re-runs `set` whenever the agreed order changes anyway.
_write() {
  local i dir tmp
  if [[ ${#REFS[@]} -eq 0 ]]; then
    rm -f "$QUEUE"
    return 0
  fi
  dir=$(dirname "$QUEUE")
  mkdir -p "$dir"
  tmp="$QUEUE.tmp.$$"
  : > "$tmp"
  for ((i = 0; i < ${#REFS[@]}; i++)); do
    if [[ -n "${TITLES[$i]}" ]]; then
      printf '%s\t%s\t%s\n' "${REFS[$i]}" "${NOTES[$i]}" "${TITLES[$i]}" >> "$tmp"
    elif [[ -n "${NOTES[$i]}" ]]; then
      printf '%s\t%s\n' "${REFS[$i]}" "${NOTES[$i]}" >> "$tmp"
    else
      printf '%s\n' "${REFS[$i]}" >> "$tmp"
    fi
  done
  mv -f "$tmp" "$QUEUE"
}

# The one line a write answers with: the new order, refs only.
_summary() {
  [[ "$QUIET" == 1 ]] && return 0
  if [[ ${#REFS[@]} -eq 0 ]]; then
    echo "queue: (empty)"
  else
    echo "queue: ${REFS[*]}"
  fi
}

# Index of the queued ref an <option> <ref>=<text> argument names, or an error.
_named_index() {
  local ref="${2%%=*}"
  _index_of "$ref" && return 0
  echo "Error: $1 names $ref, which is not in the queue" >&2
  return 2
}

# Apply every --note to NOTES and every --title to TITLES.
_apply_notes() {
  local n i
  for n in "${NOTE_ARGS[@]+"${NOTE_ARGS[@]}"}"; do
    i=$(_named_index --note "$n") || exit 2
    NOTES[i]=$(_clean_note "${n#*=}")
  done
  for n in "${TITLE_ARGS[@]+"${TITLE_ARGS[@]}"}"; do
    i=$(_named_index --title "$n") || exit 2
    TITLES[i]=$(_clean_note "${n#*=}")
  done
}

# ----- commands -------------------------------------------------------------

case "$CMD" in
  show)
    if [[ ${#REFS[@]} -eq 0 ]]; then
      [[ "$QUIET" == 1 ]] || echo "queue: (empty)"
      exit 0
    fi
    for ((i = 0; i < ${#REFS[@]}; i++)); do
      printf '%d  %s' "$((i + 1))" "${REFS[$i]}"
      [[ -n "${TITLES[$i]}" ]] && printf '  [%s]' "${TITLES[$i]}"
      [[ -n "${NOTES[$i]}" ]] && printf '  %s' "${NOTES[$i]}"
      printf '\n'
    done
    ;;
  set)
    OLD_REFS=("${REFS[@]+"${REFS[@]}"}")
    OLD_NOTES=("${NOTES[@]+"${NOTES[@]}"}")
    OLD_TITLES=("${TITLES[@]+"${TITLES[@]}"}")
    REFS=()
    NOTES=()
    TITLES=()
    for ref in "${ARGS[@]}"; do
      _check_ref "$ref"
      _index_of "$ref" >/dev/null && continue
      note=""
      title=""
      for ((i = 0; i < ${#OLD_REFS[@]}; i++)); do
        if [[ "$(_key "${OLD_REFS[$i]}")" == "$(_key "$ref")" ]]; then
          note="${OLD_NOTES[$i]}"
          title="${OLD_TITLES[$i]}"
          break
        fi
      done
      REFS+=("$(_strip_hashes "$ref")")
      NOTES+=("$note")
      TITLES+=("$title")
    done
    _apply_notes
    _write
    _summary
    ;;
  add)
    for ref in "${ARGS[@]}"; do
      _check_ref "$ref"
      _index_of "$ref" >/dev/null && continue
      REFS+=("$(_strip_hashes "$ref")")
      NOTES+=("")
      TITLES+=("")
    done
    _apply_notes
    _write
    _summary
    ;;
  rm)
    for ref in "${ARGS[@]}"; do
      [[ -n "$ref" ]] || continue
      i=$(_index_of "$ref") || continue
      KEEP_REFS=()
      KEEP_NOTES=()
      KEEP_TITLES=()
      for ((j = 0; j < ${#REFS[@]}; j++)); do
        [[ "$j" -eq "$i" ]] && continue
        KEEP_REFS+=("${REFS[$j]}")
        KEEP_NOTES+=("${NOTES[$j]}")
        KEEP_TITLES+=("${TITLES[$j]}")
      done
      REFS=("${KEEP_REFS[@]+"${KEEP_REFS[@]}"}")
      NOTES=("${KEEP_NOTES[@]+"${KEEP_NOTES[@]}"}")
      TITLES=("${KEEP_TITLES[@]+"${KEEP_TITLES[@]}"}")
    done
    _write
    _summary
    ;;
  clear)
    REFS=()
    NOTES=()
    TITLES=()
    _write
    _summary
    ;;
esac
