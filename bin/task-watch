#!/usr/bin/env bash
set -euo pipefail

# task-watch — poll Jira for ai-auto bugs, claim each once, radio the PM (#328).
#
# claude-jira only. Shell, zero model tokens: it runs in the foreground in its
# own tab and does three things per poll.
#
#   1. Refresh what is in flight. Every ticket it claimed is recorded in a
#      ledger, $TASK_FORCE_HOME/watch/<repo>/<KEY>. A ledger entry is
#      `pending` from the claim until the PM dispatches it, `running` while a
#      task-work worktree's `.<slug>.info` sidecar names the key, and `done`
#      once that worktree is gone. A pending ticket is resolved from Jira:
#      it stops holding a slot once its status is done (a run that went start
#      to finish between two polls, counted as one), it carries
#      `<label>:needs-info` or `<label>:failed`, or it lost `<label>:claimed`.
#      One pending past <pending timeout minutes> counts as a failed run and
#      goes back into the queue, or to `<label>:failed` once that makes the cap.
#      A ticket released by a bounce (`<label>:needs-info`) is `bounced`: the
#      ledger keeps the time the watcher saw it and a checksum of its
#      description. Each poll also searches for `<label>:needs-info`, and a
#      bounced ticket with a reply since (a comment by anyone but the account
#      acli is logged in as, which the PM posts as too, or an edited
#      description) is requeued in one edit: `<label>` added, `<label>:claimed`
#      and `<label>:needs-info` removed (#338). So is one whose `needs-info` was
#      removed by hand while `claimed` stayed on: the half-done label swap. A
#      requeue is not a failed run; after <bounce cap> bounces the ticket is
#      left on `needs-info` for good.
#   2. Search the queue through `acli` (#326: a REST search with a lapsed token
#      returns 200 and zero issues; an `acli` read exits 1). Any non-zero acli
#      exit stops the watcher and radios the PM that a re-login is needed. No
#      retry loop.
#   3. For each hit, while fewer than <max in flight> tickets are pending or
#      running: claim it (one label swap, `<label>` -> `<label>:claimed`), and
#      only after the claim succeeded, `radio send --to pm --intent
#      ticket-filed --issue <KEY>`. Claim before ping, so a crash never
#      double-dispatches. An acli write exits 0 when it fails, so every write
#      runs with --json and checks successCount.
#
# It also rotates the PM (#334). Before the queue, each poll checks the PM's
# caps: context (the last assistant turn's tokens in the transcript radio
# recorded at register), tickets handed to it, and age. Before claiming a
# ticket whose group (its parent epic, else a **Watch group labels** label)
# differs from the PM's, it rotates too, so the new group starts on a fresh PM.
# Only at a quiet point (PM idle, inbox empty, no review running), and, but for
# the context cap, only once nothing of the PM's own group is in flight. A
# rotation radios `handoff-requested`, waits for `handoff-done` and a fresh
# handoff note, then `radio clear` types `/clear` with the rotation marker set,
# so the re-register prints the digest and the note. No note, no rotation: past
# <handoff timeout minutes> it gives up and tries again at the next quiet point.
#
# A ticket that comes back into the queue after a run was dispatched for it
# means that run failed. Once <failure cap> runs have, the ticket gets
# `<label>:failed` instead of a claim and is never claimed again.
#
# Settings come from .claude/jira-workflow.md in the main checkout, which a
# local-only install (#327) leaves untracked but in the same place. The LAST
# matching bullet wins, so an override below the managed-region end marker
# beats the template's defaults and survives every task-init re-run.
#
# Must run on /bin/bash 3.2: no associative arrays, no mapfile.

# Resolve own path through symlinks -> AW_ROOT.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src != /* ]] && src="$dir/$src"
done
BIN_DIR=$(cd -P "$(dirname "$src")" && pwd)
AW_ROOT=$(dirname "$BIN_DIR")
RADIO="$BIN_DIR/radio"

# shellcheck source=lib/repo-name.sh
source "$AW_ROOT/lib/repo-name.sh"
# shellcheck source=lib/tracker-settings.sh
source "$AW_ROOT/lib/tracker-settings.sh"
# shellcheck source=lib/require-jq.sh
source "$AW_ROOT/lib/require-jq.sh"
# shellcheck source=lib/doc-setting.sh
source "$AW_ROOT/lib/doc-setting.sh"

usage() {
  cat <<'EOF'
Usage: task-watch [--once]

Poll Jira for labelled bugs, claim each one once, and radio the PM a
`ticket-filed` message for it. Run it from the repo (main checkout or any
worktree), in a tab of its own; it polls until stopped.

  --once   run a single poll and exit

Settings, read from .claude/jira-workflow.md (last matching bullet wins):
  Watch label           ai-auto   claim swaps it for <label>:claimed; a bounce
                                  adds <label>:needs-info; the cap <label>:failed
  Watch issue type      Bug
  Watch JQL             default   project, issue type and label, minus claimed
                                  and failed tickets, oldest first
  Watch poll seconds    300
  Watch max in flight   2         tickets claimed but not yet finished
  Watch failure cap     2         dispatched runs before <label>:failed
  Watch pending timeout minutes
                        120       claimed, never seen with a worktree: after
                                  this it counts as a failed run and is re-queued
  Watch bounce cap      3         bounces before a ticket stays on
                                  <label>:needs-info instead of being requeued
                                  when the reporter replies

PM rotation (#334): at a quiet point, the PM is asked for a handoff note and
then cleared once it crosses a cap (0 turns one off), or before a ticket from
another group than its own is filed:
  Watch rotate context tokens   150000
  Watch rotate tickets          6
  Watch rotate age minutes      480
  Watch handoff timeout minutes 15
  Watch rotation marker minutes 5       a marker the /clear never consumed
                                        is dropped after this
  Watch group labels            none    labels (globs allowed) that group a
                                        ticket with no parent epic

A reply is a comment by anyone but the account acli is logged in as (read from
acli's jira_config.yaml), or an edit to the description, after the watcher saw
the bounce.

It reads and writes Jira through acli (acli jira auth login --web). Any
non-zero acli exit stops it and radios the PM to re-login.
Its log lines go to the radio log with a `watch:` prefix.
EOF
  exit "${1:-1}"
}

ONCE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --once) ONCE=1; shift ;;
    -h|--help) usage 0 ;;
    *) echo "Error: unknown argument '$1'" >&2; usage ;;
  esac
done

require_jq_1_6 || exit 1
command -v acli >/dev/null 2>&1 || {
  echo "Error: acli not found on PATH. Install the Atlassian CLI and run: acli jira auth login --web" >&2
  exit 1
}

MAIN_ROOT=$(aw_main_repo_root "$PWD") || { echo "Error: not in a git repo" >&2; exit 1; }
DOC="$MAIN_ROOT/.claude/jira-workflow.md"
if [[ ! -f "$DOC" ]]; then
  echo "Error: no .claude/jira-workflow.md in $MAIN_ROOT — task-watch is claude-jira only (task-init claude-jira)" >&2
  exit 1
fi
REPO_NAME=$(aw_main_repo_name "$MAIN_ROOT")
# task-work's own layout: <repo>/../<repo-basename>-worktrees/.<slug>.info
WORKTREE_BASE="$MAIN_ROOT/../$(basename "$MAIN_ROOT")-worktrees"
TF_HOME="${TASK_FORCE_HOME:-$HOME/.task-force}"
LOG_FILE="$TF_HOME/radio/log"
LEDGER="$TF_HOME/watch/$REPO_NAME"
WATCH_ROLE="watch-$REPO_NAME"
PM_ROLE="pm-$REPO_NAME"
PM_SESSION="$TF_HOME/radio/sessions/$PM_ROLE.info"
PM_GROUP_NAME=""

_log() {
  mkdir -p "$(dirname "$LOG_FILE")"
  printf '%s watch: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$LOG_FILE"
}

# Say it on stdout and in the radio log.
_say() {
  printf 'task-watch: %s\n' "$*"
  _log "$* repo=$REPO_NAME"
}

# _setting <bullet name> <default>: the last `- **<name>**: `<value>`` in the doc.
_setting() { tf_doc_setting "$DOC" "$1" "$2"; }
_number_setting() { tf_doc_number_setting "$DOC" "$1" "$2" || exit 1; }

LABEL=$(_setting "Watch label" ai-auto)
CLAIMED="$LABEL:claimed"
NEEDS_INFO="$LABEL:needs-info"
FAILED="$LABEL:failed"
ISSUE_TYPE=$(_setting "Watch issue type" Bug)
INTERVAL=$(_number_setting "Watch poll seconds" 300)
MAX_INFLIGHT=$(_number_setting "Watch max in flight" 2)
FAIL_CAP=$(_number_setting "Watch failure cap" 2)
PENDING_TIMEOUT=$(_number_setting "Watch pending timeout minutes" 120)
BOUNCE_CAP=$(_number_setting "Watch bounce cap" 3)
ROTATE_CONTEXT=$(_number_setting "Watch rotate context tokens" 150000)
ROTATE_TICKETS=$(_number_setting "Watch rotate tickets" 6)
ROTATE_AGE=$(_number_setting "Watch rotate age minutes" 480)
HANDOFF_TIMEOUT=$(_number_setting "Watch handoff timeout minutes" 15)
MARKER_TTL=$(_number_setting "Watch rotation marker minutes" 5)
GROUP_LABELS=$(_setting "Watch group labels" none)
[[ "$GROUP_LABELS" != none ]] || GROUP_LABELS=""
GROUP_PATTERNS=()
IFS=', ' read -r -a GROUP_PATTERNS <<<"$GROUP_LABELS" || true
PROJECT_KEY=$(tf_tracker_value "$DOC" jira key)
SITE=$(tf_tracker_value "$DOC" jira site)

PROJECT_CLAUSE=""
if [[ "$PROJECT_KEY" == *,* ]]; then
  PROJECT_CLAUSE="project in ($PROJECT_KEY)"
elif [[ -n "$PROJECT_KEY" ]]; then
  PROJECT_CLAUSE="project = \"$PROJECT_KEY\""
fi
JQL=$(_setting "Watch JQL" "")
if [[ -z "$JQL" ]]; then
  if [[ -z "$PROJECT_KEY" ]]; then
    echo "Error: no project key in $DOC — fill in **Project key(s)**, or set **Watch JQL**" >&2
    exit 1
  fi
  JQL="$PROJECT_CLAUSE AND issuetype = \"$ISSUE_TYPE\" AND labels = \"$LABEL\" AND labels not in (\"$CLAIMED\", \"$FAILED\") ORDER BY created ASC"
fi

# The account acli posts as, which the PM's comments come from too: its
# comments on a bounced ticket are never a reply. acli keeps it in its profile
# file, `current_profile: <cloud id>:<account id>` and one `account_id:` per
# profile. Empty when that file is missing or unreadable.
_self_account() {
  local cfg="${TASK_WATCH_ACLI_CONFIG:-$HOME/.config/acli/jira_config.yaml}" cp id
  [[ -f "$cfg" ]] || return 0
  cp=$(sed -nE 's/^current_profile:[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/p' "$cfg" | head -n 1)
  [[ -n "$cp" ]] || return 0
  while IFS= read -r id; do
    if [[ -n "$id" && "$cp" == *":$id" ]]; then printf '%s' "$id"; return 0; fi
  done < <(sed -nE 's/^[[:space:]-]*account_id:[[:space:]]*"?([^"[:space:]]*)"?[[:space:]]*$/\1/p' "$cfg")
}
SELF=$(_self_account)

# ---------------- ledger ----------------
# One file per claimed key, KEY=VALUE lines: STATE, CLAIMS, RUNS, PINGED,
# SUMMARY, PENDING_SINCE, and for a bounce BOUNCES, BOUNCED_AT, DESC_SUM.

_ledger_get() {
  local f="$LEDGER/$1"
  [[ -f "$f" ]] || return 0
  awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$f"
}

_ledger_set() {
  local f="$LEDGER/$1" k="$2" v="$3"
  mkdir -p "$LEDGER"
  v=${v//$'\n'/ }
  {
    if [[ -f "$f" ]]; then awk -v k="$k" 'index($0, k "=") != 1' "$f"; fi
    printf '%s=%s\n' "$k" "$v"
  } >"$f.tmp.$$"
  mv -f "$f.tmp.$$" "$f"
}

_ledger_incr() {
  local n
  n=$(_ledger_get "$1" "$2")
  _ledger_set "$1" "$2" "$(( ${n:-0} + 1 ))"
}

# One watcher per repo: two would race each other's label swaps.
LOCK="$LEDGER/.lock"
mkdir -p "$LEDGER"
if ! mkdir "$LOCK" 2>/dev/null; then
  holder=$(cat "$LOCK/pid" 2>/dev/null || true)
  if [[ -n "$holder" ]] && kill -0 "$holder" 2>/dev/null; then
    echo "Error: task-watch is already running for $REPO_NAME (pid $holder)" >&2
    exit 1
  fi
  rm -rf "$LOCK"
  mkdir "$LOCK"
fi
echo "$$" >"$LOCK/pid"
TMP=$(mktemp -d)
trap 'rm -rf "$LOCK" "$TMP"' EXIT

# ---------------- radio ----------------

_radio_pm() {
  # $1 intent, $2 key (may be empty); body on stdin.
  env TASK_FORCE_ROLE="$WATCH_ROLE" TASK_FORCE_PM_ROLE="$PM_ROLE" \
    "$RADIO" send --to pm --intent "$1" ${2:+--issue "$2"}
}

# Stop on a failed acli call: no retry loop (#326). Radios the PM, exits 3.
_stop() {
  local what="$1" rc="$2" err="$3"
  _say "stopped: acli $what exited $rc (${err:-no output}) — re-login with: acli jira auth login --web"
  _radio_pm watch-stopped "" <<BODY || true
task-watch for $REPO_NAME stopped: acli $what exited $rc.
${err:-acli printed nothing.}
Most likely the acli login lapsed. Re-login, then restart task-watch in its tab:
  acli jira auth login --web
BODY
  exit 3
}

# ---------------- acli ----------------

# The first non-blank line across the files given: where acli said why.
_first_line() {
  cat "$@" 2>/dev/null | grep -v '^[[:space:]]*$' | head -n 1 || true
}

# _search <jql> <outfile>: the matching issues as a JSON array.
_search() {
  local rc=0
  acli jira workitem search --jql "$1" --fields key,labels,status,summary,parent \
    --paginate --json >"$2" 2>"$TMP/err" || rc=$?
  if (( rc != 0 )); then
    _stop search "$rc" "$(_first_line "$TMP/err" "$2")"
  fi
  if ! jq -e 'type == "array"' "$2" >/dev/null 2>&1; then
    _stop search 0 "output was not a JSON array"
  fi
}

# _swap <key> <add> <remove>: one label swap. True only when Jira says it
# happened — a failed acli write exits 0 (#326).
_swap() {
  local rc=0 out="$TMP/edit"
  acli jira workitem edit --key "$1" --labels "$2" --remove-labels "$3" \
    --yes --json >"$out" 2>"$TMP/err" || rc=$?
  (( rc == 0 )) || _stop "edit $1" "$rc" "$(_first_line "$TMP/err" "$out")"
  [[ "$(jq -r '.successCount // 0' "$out" 2>/dev/null || echo 0)" == 1 ]] && return 0
  _say "label swap on $1 ($3 -> $2) failed: $(jq -r '[.results[]?.message // empty] | first // "no successCount"' "$out" 2>/dev/null || echo 'unreadable output')"
  return 1
}

# _view <key> <outfile>: the ticket's comments and description, as JSON.
_view() {
  local rc=0
  acli jira workitem view "$1" --fields comment,description --json >"$2" 2>"$TMP/err" || rc=$?
  (( rc == 0 )) || _stop "view $1" "$rc" "$(_first_line "$TMP/err" "$2")"
}

# A checksum of the description in a _view file: an edit changes it.
_desc_sum() {
  jq -c '.fields.description // null' "$1" 2>/dev/null | cksum | awk '{ print $1 }'
}

# jq defs: `epoch` turns a Jira time, `2026-10-30T22:48:06.665-0700`, into
# seconds since 1970. Plain arithmetic (days from the civil date): jq's
# fromdateiso8601 goes through mktime, which is an hour off across DST on some
# platforms.
# shellcheck disable=SC2016 # jq source: its $vars are jq's, not the shell's
JQ_EPOCH='
    def days($y; $m; $d):
      ($y - (if $m <= 2 then 1 else 0 end)) as $y
      | ($y / 400 | floor) as $era
      | ($y - $era * 400) as $yoe
      | (((153 * ($m + (if $m > 2 then -3 else 9 end)) + 2) / 5 | floor) + $d - 1) as $doy
      | ($yoe * 365 + ($yoe / 4 | floor) - ($yoe / 100 | floor) + $doy) as $doe
      | $era * 146097 + $doe - 719468;
    def epoch:
      capture("^(?<y>[0-9]{4})-(?<mo>[0-9]{2})-(?<d>[0-9]{2})T(?<h>[0-9]{2}):(?<mi>[0-9]{2}):(?<s>[0-9]{2})(\\.[0-9]+)?(?<z>.*)$")
      | (days(.y | tonumber; .mo | tonumber; .d | tonumber) * 86400
         + (.h | tonumber) * 3600 + (.mi | tonumber) * 60 + (.s | tonumber))
        - (.z | sub(":"; "")
           | if test("^[+-][0-9]{4}$")
             then ((.[1:3] | tonumber) * 3600 + (.[3:5] | tonumber) * 60)
                  * (if .[0:1] == "-" then -1 else 1 end)
             else 0 end);'

# Comments in a _view file created after epoch $2 by anyone but $SELF.
_replies_since() {
  jq --argjson since "$2" --arg self "$SELF" "$JQ_EPOCH"'
    [(.fields.comment.comments // [])[]
     | select((.author.accountId // "") != $self)
     | select((try (.created | epoch) catch 0) > $since)]
    | length' "$1" 2>/dev/null || echo 0
}

# The epoch of the newest comment in a _view file by $SELF, or nothing.
_last_own_comment() {
  [[ -n "$SELF" ]] || return 0
  jq -r --arg self "$SELF" "$JQ_EPOCH"'
    [(.fields.comment.comments // [])[]
     | select((.author.accountId // "") == $self)
     | (try (.created | epoch) catch empty)]
    | max // empty' "$1" 2>/dev/null || true
}

_browse_url() {
  local s="${SITE%/}"
  [[ -n "$s" ]] || return 0
  [[ "$s" == *://* ]] || s="https://$s"
  [[ "${s#*://}" == *.* ]] || s="$s.atlassian.net"
  printf '%s/browse/%s' "$s" "$1"
}

# ---------------- in flight ----------------

# Keys a live task-work worktree is working on, one per line, uppercased.
_live_keys() {
  local f ref slug
  for f in "$WORKTREE_BASE"/.*.info; do
    [[ -f "$f" ]] || continue
    ref=$(sed -n 's/^JIRA_REF=//p' "$f" | head -n 1)
    slug=$(sed -n 's/^SLUG=//p' "$f" | head -n 1)
    [[ -n "$ref" && -n "$slug" && -d "$WORKTREE_BASE/$slug" ]] || continue
    printf '%s\n' "$ref" | tr '[:lower:]' '[:upper:]' | grep -oE '[A-Z][A-Z0-9_]+-[0-9]+' | tail -n 1 || true
  done
}

_ping() {
  local key="$1" summary url out claims
  summary=$(_ledger_get "$key" SUMMARY)
  claims=$(_ledger_get "$key" CLAIMS)
  url=$(_browse_url "$key")
  if out=$(_radio_pm ticket-filed "$key" <<BODY
$key: $summary
${url:-$key}
Claimed by task-watch (claim ${claims:-1}; ${FAIL_CAP} failed run(s) mark it $FAILED). Triage it: dispatch with task-work --auto, or bounce with $NEEDS_INFO.
BODY
  ); then
    _ledger_set "$key" PINGED 1
    _say "ticket-filed $key → ${out##*$'\n'}"
  else
    _say "radio send failed for $key — will retry the ping next poll"
  fi
}

# Sets INFLIGHT. Advances every pending / running / bounced ledger entry.
_refresh() {
  INFLIGHT=0
  local live f key state pending="" bounced="" fresh=" "
  live=$(_live_keys)
  for f in "$LEDGER"/*; do
    [[ -f "$f" ]] || continue
    key=$(basename "$f")
    state=$(_ledger_get "$key" STATE)
    case "$state" in pending|running|bounced) ;; *) continue ;; esac
    if printf '%s\n' "$live" | grep -qxF "$key"; then
      if [[ "$state" != running ]]; then
        _ledger_set "$key" STATE running
        _ledger_incr "$key" RUNS
        _say "$key dispatched — run $(_ledger_get "$key" RUNS) in flight"
      fi
      INFLIGHT=$((INFLIGHT + 1))
    elif [[ "$state" == running ]]; then
      _ledger_set "$key" STATE "done"
      _say "$key run ended (worktree gone)"
    elif [[ "$state" == bounced ]]; then
      bounced+="$key "
    else
      pending+="$key "
    fi
  done
  if [[ -n "$pending$bounced" ]]; then
    _resolve_pending "$pending"
  fi
  _bounced_pass "$bounced"
}

# Resolves the pending keys in $1 from Jira, and leaves the claimed search in
# $TMP/pending.json for _bounced_pass. Adds each key it bounces to $fresh.
_resolve_pending() {
  local key pending="$1"

  # Pending: claimed, and never yet seen with a live worktree. Jira says
  # whether it still holds a slot. Searched by the claimed label rather than
  # `key in (...)`, which exits 1 once one of the keys has been deleted (#335).
  _search "${PROJECT_CLAUSE:+$PROJECT_CLAUSE AND }labels = \"$CLAIMED\"" "$TMP/pending.json"
  local labels category since now
  now=$(date +%s)
  for key in $pending; do
    labels=$(jq -r --arg k "$key" '.[] | select(.key == $k) | .fields.labels // [] | .[]' "$TMP/pending.json")
    category=$(jq -r --arg k "$key" '.[] | select(.key == $k) | .fields.status.statusCategory.key // ""' "$TMP/pending.json")
    if ! printf '%s\n' "$labels" | grep -qxF "$CLAIMED"; then
      # Not claimed any more, or deleted.
      _ledger_set "$key" STATE released
      _say "$key released ($CLAIMED removed) — no longer in flight"
      continue
    fi
    if [[ "$category" == "done" ]]; then
      # A run went start to finish between two polls: it still counts as one.
      _ledger_set "$key" STATE "done"
      _ledger_incr "$key" RUNS
      _say "$key released (status done) — no longer in flight"
      continue
    fi
    if printf '%s\n' "$labels" | grep -qxF "$FAILED"; then
      _ledger_set "$key" STATE failed
      _say "$key released ($FAILED) — no longer in flight"
      continue
    fi
    if printf '%s\n' "$labels" | grep -qxF "$NEEDS_INFO"; then
      _record_bounce "$key"
      fresh+="$key "
      continue
    fi
    since=$(_ledger_get "$key" PENDING_SINCE)
    if [[ ! "$since" =~ ^[0-9]+$ ]]; then since=$now; _ledger_set "$key" PENDING_SINCE "$now"; fi
    if (( now - since >= PENDING_TIMEOUT * 60 )); then
      _pending_timeout "$key"
      continue
    fi
    INFLIGHT=$((INFLIGHT + 1))
    [[ "$(_ledger_get "$key" PINGED)" == 1 ]] || _ping "$key"
  done
}

# The PM bounced <key>: remember when the watcher saw it, and what the
# description said then, so a reply after it can be told from what came before.
#
# The baseline is the PM's bounce comment, the newest by the acli account since
# the claim, so a reply between that comment and this poll still counts. With
# none (the comment is not posted yet, or the account is unknown) it is now.
# A description edit in that window is not caught: the checksum is taken now.
_record_bounce() {
  local key="$1" bounces now own claimed
  _view "$key" "$TMP/view.json"
  now=$(date +%s)
  own=$(_last_own_comment "$TMP/view.json")
  claimed=$(_ledger_get "$key" PENDING_SINCE)
  [[ "$claimed" =~ ^[0-9]+$ ]] || claimed=0
  if [[ "$own" =~ ^[0-9]+$ ]] && (( own >= claimed && own <= now )); then
    now=$own
  fi
  _ledger_set "$key" STATE bounced
  _ledger_set "$key" BOUNCED_AT "$now"
  _ledger_set "$key" DESC_SUM "$(_desc_sum "$TMP/view.json")"
  _ledger_incr "$key" BOUNCES
  bounces=$(_ledger_get "$key" BOUNCES)
  if (( bounces >= BOUNCE_CAP )); then
    _say "$key released (bounced, $NEEDS_INFO) — bounce $bounces of $BOUNCE_CAP: the cap, left on $NEEDS_INFO and never requeued"
  else
    _say "$key released (bounced, $NEEDS_INFO) — bounce $bounces of $BOUNCE_CAP, requeued once the reporter replies"
  fi
}

# Bounced tickets: requeue the ones the reporter answered (#338). $1 is the
# bounced keys the ledger already had; $fresh the ones bounced this poll,
# which nobody can have answered yet.
_bounced_pass() {
  local bounced="$1" key labels category n since sum why seen=" "
  _search "${PROJECT_CLAUSE:+$PROJECT_CLAUSE AND }labels = \"$NEEDS_INFO\"" "$TMP/needs.json"
  n=$(jq 'length' "$TMP/needs.json")
  local i
  for (( i = 0; i < n; i++ )); do
    key=$(jq -r --argjson i "$i" '.[$i].key' "$TMP/needs.json")
    labels=$(jq -r --argjson i "$i" '.[$i].fields.labels // [] | .[]' "$TMP/needs.json")
    category=$(jq -r --argjson i "$i" '.[$i].fields.status.statusCategory.key // ""' "$TMP/needs.json")
    seen+="$key "
    [[ "$fresh" == *" $key "* ]] && continue
    if [[ "$category" == "done" ]]; then
      if [[ "$(_ledger_get "$key" STATE)" == bounced ]]; then
        _ledger_set "$key" STATE released
        _say "$key no longer bounced (status done)"
      fi
      continue
    fi
    printf '%s\n' "$labels" | grep -qxF "$FAILED" && continue
    if [[ "$(_ledger_get "$key" STATE)" != bounced ]]; then
      # Bounced before the watcher looked (an older watcher, or between two
      # polls by hand): adopt it, if it is the watcher's own ticket.
      if [[ -f "$LEDGER/$key" ]] || printf '%s\n' "$labels" | grep -qxF "$CLAIMED"; then
        _record_bounce "$key"
      fi
      continue
    fi
    _under_bounce_cap "$key" || continue
    _view "$key" "$TMP/view.json"
    since=$(_ledger_get "$key" BOUNCED_AT)
    [[ "$since" =~ ^[0-9]+$ ]] || since=0
    sum=$(_ledger_get "$key" DESC_SUM)
    why=""
    if [[ -n "$SELF" ]] && (( $(_replies_since "$TMP/view.json" "$since") > 0 )); then
      why="reporter replied"
    elif [[ -n "$sum" && "$(_desc_sum "$TMP/view.json")" != "$sum" ]]; then
      why="description edited"
    fi
    [[ -n "$why" ]] && _requeue "$key" "$why"
  done
  if [[ -z "$SELF" && "$seen" != " " && -z "${WARNED_SELF:-}" ]]; then
    WARNED_SELF=1
    _say "cannot tell the reporter's comments from the PM's: no account_id in acli's jira_config.yaml — requeueing on description edits only"
  fi

  # Bounced tickets that lost $NEEDS_INFO.
  for key in $bounced; do
    [[ "$seen" == *" $key "* ]] && continue
    labels=$(jq -r --arg k "$key" '.[] | select(.key == $k) | .fields.labels // [] | .[]' "$TMP/pending.json" 2>/dev/null || true)
    category=$(jq -r --arg k "$key" '.[] | select(.key == $k) | .fields.status.statusCategory.key // ""' "$TMP/pending.json" 2>/dev/null || true)
    if printf '%s\n' "$labels" | grep -qxF "$CLAIMED" && [[ "$category" != "done" ]] \
      && ! printf '%s\n' "$labels" | grep -qxF "$FAILED"; then
      # The half-done swap: the reporter took $NEEDS_INFO off and left
      # $CLAIMED on, which keeps the ticket out of the queue.
      if _under_bounce_cap "$key"; then
        _requeue "$key" "$NEEDS_INFO removed"
      fi
      continue
    fi
    # Re-queued in full by hand, closed, or relabelled: no longer bounced.
    _ledger_set "$key" STATE released
    _say "$key no longer bounced ($NEEDS_INFO removed)"
  done
}

_under_bounce_cap() {
  local b
  b=$(_ledger_get "$1" BOUNCES)
  (( ${b:-0} < BOUNCE_CAP ))
}

# _requeue <key> <why>: back into the queue in one edit. Not a failed run.
_requeue() {
  local key="$1" why="$2"
  _swap "$key" "$LABEL" "$CLAIMED,$NEEDS_INFO" || return 0
  _ledger_set "$key" STATE requeued
  _say "requeued $key ($why)"
}

# A ticket pending past the timeout counts as a failed run. It goes back into
# the queue for another try, or, once that makes the cap, to <label>:failed.
_pending_timeout() {
  local key="$1" runs
  _ledger_incr "$key" RUNS
  runs=$(_ledger_get "$key" RUNS)
  _log "pending timeout $key (${PENDING_TIMEOUT}m, failed run $runs of $FAIL_CAP) repo=$REPO_NAME"
  if (( runs >= FAIL_CAP )); then
    _swap "$key" "$FAILED" "$CLAIMED" || return 0
    _ledger_set "$key" STATE failed
    _say "$key pending past ${PENDING_TIMEOUT}m — failed run $runs of $FAIL_CAP, labelled $FAILED"
  else
    _swap "$key" "$LABEL" "$CLAIMED" || return 0
    _ledger_set "$key" STATE released
    _say "$key pending past ${PENDING_TIMEOUT}m — failed run $runs of $FAIL_CAP, back in the queue"
  fi
}

# ---------------- PM rotation (#334) ----------------
# The PM the watcher feeds is tracked in $LEDGER/.pm: GEN (one per PM, and one
# more per rotation), PM_ID (the radio session's REGISTERED_AT, so a new PM is
# told from a `/clear` of this one), STARTED, TICKETS (ticket-filed sent to
# it), GROUP (the group of the first grouped ticket it took), and while a
# rotation is under way PHASE=requested, REQUESTED_AT, REASON, DETAIL. Each
# ticket's ledger entry records the GEN and GROUP it was handed with.

_pm_get() { _ledger_get .pm "$1"; }
_pm_set() { _ledger_set .pm "$1" "$2"; }
_pm_field() {
  [[ -f "$PM_SESSION" ]] || return 0
  sed -n "s/^$1=//p" "$PM_SESSION" | head -n 1
}

_mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0; }

# A new PM generation: counters from zero.
_pm_new() {
  local gen
  gen=$(_pm_get GEN)
  _pm_set GEN "$(( ${gen:-0} + 1 ))"
  _pm_set STARTED "$(date +%s)"
  _pm_set TICKETS 0
  _pm_set GROUP ""
  _pm_set PHASE ""
  _pm_set DEFERRED ""
  _pm_set ROTATED_SID ""
  _log "tracking $PM_ROLE generation $(_pm_get GEN) ($1) repo=$REPO_NAME"
}

# Notice a PM started (or restarted by hand) since the last poll.
_pm_track() {
  local id
  [[ -f "$PM_SESSION" ]] || return 0
  id=$(_pm_field REGISTERED_AT)
  if [[ -z "$(_pm_get GEN)" ]]; then
    _pm_set PM_ID "$id"
    _pm_new "first seen"
  elif [[ -n "$id" && -z "$(_pm_get PM_ID)" ]]; then
    # A PM registered before REGISTERED_AT existed gets one at its first
    # re-register: the same PM, adopted with its counters.
    _pm_set PM_ID "$id"
    _log "adopted $PM_ROLE's REGISTERED_AT=$id, generation $(_pm_get GEN) kept repo=$REPO_NAME"
  elif [[ "$id" != "$(_pm_get PM_ID)" ]]; then
    _pm_set PM_ID "$id"
    _pm_new "new session"
  fi
}

# The PM's current context size in tokens: the last main-thread assistant
# turn's input + cache-read + cache-creation tokens, from the transcript radio
# recorded at register (else found by the session id). Nothing when unknown.
_pm_context() {
  local tp sid
  tp=$(_pm_field TRANSCRIPT)
  if [[ -z "$tp" || ! -f "$tp" ]]; then
    sid=$(_pm_field SESSION_ID)
    [[ -n "$sid" ]] || return 0
    tp=$(find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects" -maxdepth 2 -name "$sid.jsonl" 2>/dev/null | head -n 1)
  fi
  [[ -n "$tp" && -f "$tp" ]] || return 0
  tail -n 500 "$tp" | jq -R -r '
    fromjson? | select(.type == "assistant" and .isSidechain != true and (.message.usage | type) == "object")
    | .message.usage | (.input_tokens // 0) + (.cache_read_input_tokens // 0) + (.cache_creation_input_tokens // 0)' \
    2>/dev/null | tail -n 1 || true
}

# True while the context reading is still the rotated-out session's: the
# /clear re-register has not recorded a new SESSION_ID, and the transcript is
# no newer than the rotation. Once either changes, the marker is dropped.
_context_stale() {
  local rsid tp started
  rsid=$(_pm_get ROTATED_SID)
  [[ -n "$rsid" ]] || return 1
  tp=$(_pm_field TRANSCRIPT) started=$(_pm_get STARTED)
  if [[ "$(_pm_field SESSION_ID)" == "$rsid" ]] \
    && { [[ -z "$tp" || ! -f "$tp" ]] || (( $(_mtime "$tp") <= ${started:-0} )); }; then
    return 0
  fi
  _pm_set ROTATED_SID ""
  return 1
}

# A ticket's group, from the search file $1 at index $2: its parent (the epic),
# else its first label matching **Watch group labels** (globs allowed), else
# nothing. The watcher's own labels never count.
_group_of() {
  local parent l p
  parent=$(jq -r --argjson i "$2" '.[$i].fields.parent.key // empty' "$1")
  if [[ -n "$parent" ]]; then printf '%s' "$parent"; return 0; fi
  (( ${#GROUP_PATTERNS[@]} )) || return 0
  while IFS= read -r l; do
    [[ -n "$l" && "$l" != "$LABEL" && "$l" != "$LABEL:"* ]] || continue
    for p in "${GROUP_PATTERNS[@]}"; do
      # shellcheck disable=SC2053 # $p is a glob on purpose
      if [[ "$l" == $p ]]; then printf '%s' "$l"; return 0; fi
    done
  done < <(jq -r --argjson i "$2" '.[$i].fields.labels // [] | .[]' "$1")
}

# Tickets handed to the current PM that are still in flight, whatever their
# group: groups decide whether to rotate, never whether to wait.
_pm_inflight() {
  local f key gen n=0
  gen=$(_pm_get GEN)
  for f in "$LEDGER"/*; do
    [[ -f "$f" ]] || continue
    key=$(basename "$f")
    case "$(_ledger_get "$key" STATE)" in pending|running) ;; *) continue ;; esac
    [[ "$(_ledger_get "$key" GEN)" == "$gen" ]] || continue
    n=$((n + 1))
  done
  printf '%s' "$n"
}

# Logged once per reason, not once per poll.
_deferred() {
  [[ "$(_pm_get DEFERRED)" == "$1" ]] && return 0
  _pm_set DEFERRED "$1"
  _say "rotation deferred ($1)"
}

# Can this PM be rotated at all? claude only (no `/clear` equivalent was checked
# on kiro), and only auto-submitting: the `/clear` is typed into its box.
# Refusals are logged once per PM generation.
_rotatable() {
  local agent why=""
  agent=$(_pm_field AGENT)
  if [[ "${agent:-claude}" != claude ]]; then
    why="$PM_ROLE runs on $agent, which has no /clear task-watch can type"
  elif [[ "$(_pm_field AUTO_SUBMIT)" != 1 ]]; then
    why="$PM_ROLE is not auto-submitting (task-pm --auto-submit): its prompt box is a person's"
  fi
  [[ -z "$why" ]] && return 0
  if [[ "$(_pm_get REFUSED)" != "$(_pm_get GEN)" ]]; then
    _pm_set REFUSED "$(_pm_get GEN)"
    _say "rotation refused: $why"
  fi
  return 1
}

# A quiet point: the PM idle, its inbox empty, and no merge gate pending (no
# review of this repo's PRs still running, whose verdict the PM must act on).
# Sets QUIET_WHY when it is not one.
_quiet() {
  local state f n=0
  QUIET_WHY=""
  state=$(_pm_field STATE)
  if [[ "$state" != idle ]]; then QUIET_WHY="$PM_ROLE is ${state:-in no known state}"; return 1; fi
  for f in "$TF_HOME/radio/mailbox/$PM_ROLE/inbox"/*.md; do [[ -f "$f" ]] && n=$((n + 1)); done
  if (( n > 0 )); then QUIET_WHY="$PM_ROLE has $n unread message(s)"; return 1; fi
  for f in "$TF_HOME/radio/sessions/reviewer-$REPO_NAME-"*.info; do
    [[ -f "$f" ]] || continue
    QUIET_WHY="merge gate pending: $(basename "$f" .info) is still reviewing"
    return 1
  done
  return 0
}

# _rotation_try <reason> <detail>: start a rotation if this is a quiet point.
# 0 started, 1 deferred, 2 this PM cannot be rotated. Only the context cap gets
# past tickets of the PM's own group still in flight.
_rotation_try() {
  local reason="$1" detail="$2" n out
  _rotatable || return 2
  if ! _quiet; then _deferred "$QUIET_WHY"; return 1; fi
  if [[ "$reason" != context ]]; then
    n=$(_pm_inflight)
    if (( n > 0 )); then
      _deferred "$reason: $n ticket(s) handed to $PM_ROLE still in flight"
      return 1
    fi
  fi
  if ! out=$(_radio_pm handoff-requested "" <<BODY
task-watch is rotating this PM ($reason: $detail).
Write your handoff note now (task-monitor-queue handoff write, 5-10 lines, the usual rules), then reply:
  radio send --to $WATCH_ROLE --intent handoff-done --body "note written"
Take no other action. Once the note is written, task-watch types /clear into this session and the next PM starts from the board digest and your note.
BODY
  ); then
    _say "radio send failed for handoff-requested — rotation retried at the next quiet point"
    return 1
  fi
  _pm_set PHASE requested
  _pm_set REQUESTED_AT "$(date +%s)"
  _pm_set REASON "$reason"
  _pm_set DETAIL "$detail"
  _pm_set DEFERRED ""
  _say "rotation of $PM_ROLE requested reason=$reason ($detail) → ${out##*$'\n'}"
  return 0
}

# The PM replied handoff-done since the request: consume every handoff-done in
# the watcher's inbox, and say whether one arrived at or after $1.
_handoff_done_since() {
  local f got=1 box="$TF_HOME/radio/mailbox/$WATCH_ROLE"
  for f in "$box/inbox"/*.md; do
    [[ -f "$f" ]] || continue
    grep -qx 'intent: handoff-done' "$f" || continue
    (( $(_mtime "$f") >= $1 )) && got=0
    mkdir -p "$box/processed"
    mv -f "$f" "$box/processed/"
  done
  return "$got"
}

# A rotation under way: /clear once the PM said handoff-done and the note is
# newer than the request; give up after the timeout. 0 when the queue may run
# this poll, 1 to hold it.
_rotation_progress() {
  local req now note out
  req=$(_pm_get REQUESTED_AT) now=$(date +%s)
  [[ "$req" =~ ^[0-9]+$ ]] || req=0
  note="$TF_HOME/monitor/$REPO_NAME/handoff.md"
  if [[ "$(_pm_get DONE)" == 1 ]] || _handoff_done_since "$req"; then
    _pm_set DONE 1
    if [[ ! -s "$note" ]] || (( $(_mtime "$note") < req )); then
      _deferred "$PM_ROLE said handoff-done, but wrote no handoff note since the request"
    elif [[ "$(_pm_field STATE)" != idle ]]; then
      _deferred "handoff written, $PM_ROLE is $(_pm_field STATE): /clear waits for idle"
    elif out=$(env TASK_FORCE_ROLE="$WATCH_ROLE" "$RADIO" clear --to "$PM_ROLE" --ttl-minutes "$MARKER_TTL" 2>&1); then
      _say "rotate $PM_ROLE reason=$(_pm_get REASON) ($(_pm_get DETAIL)) → $out"
      _pm_set DONE ""
      _pm_new "rotated"
      # The old session's transcript stays on file until the /clear
      # re-register lands; its context is not the new PM's.
      _pm_set ROTATED_SID "$(_pm_field SESSION_ID)"
      return 1
    else
      _deferred "handoff written, /clear failed: ${out#radio: }"
    fi
  fi
  if (( now - req >= HANDOFF_TIMEOUT * 60 )); then
    _say "rotation of $PM_ROLE timed out: no handoff-done with a fresh note after ${HANDOFF_TIMEOUT}m — retrying at the next quiet point, never without a note"
    _pm_set PHASE ""
    _pm_set DONE ""
    _pm_set DEFERRED ""
    return 0
  fi
  return 1
}

# Once per poll, before the queue: track the PM, advance a rotation under way,
# or start one if a cap is crossed. 0 when the queue may run, 1 to hold it.
_rotation_step() {
  [[ -f "$PM_SESSION" ]] || return 0
  _pm_track
  PM_GROUP_NAME=$(_pm_get GROUP)
  if [[ "$(_pm_get PHASE)" == requested ]]; then
    _rotation_progress
    return
  fi
  local ctx tickets started now reason="" detail=""
  ctx=$(_pm_context) tickets=$(_pm_get TICKETS) started=$(_pm_get STARTED) now=$(date +%s)
  if _context_stale; then ctx=""; fi
  if (( ROTATE_CONTEXT > 0 )) && [[ "$ctx" =~ ^[0-9]+$ ]] && (( ctx >= ROTATE_CONTEXT )); then
    reason=context detail="$ctx tokens, cap $ROTATE_CONTEXT"
  elif (( ROTATE_TICKETS > 0 && ${tickets:-0} >= ROTATE_TICKETS )); then
    reason=tickets detail="$tickets ticket(s), cap $ROTATE_TICKETS"
  elif (( ROTATE_AGE > 0 )) && [[ "$started" =~ ^[0-9]+$ ]] && (( now - started >= ROTATE_AGE * 60 )); then
    reason=age detail="$(( (now - started) / 60 ))m, cap ${ROTATE_AGE}m"
  fi
  [[ -n "$reason" ]] || return 0
  if _rotation_try "$reason" "$detail"; then return 1; fi
  return 0
}

# A claimed ticket was handed to the current PM.
_pm_handed() {
  local key="$1" grp="$2" n
  _ledger_set "$key" GROUP "$grp"
  _ledger_set "$key" GEN "$(_pm_get GEN)"
  [[ -f "$PM_SESSION" ]] || return 0
  n=$(_pm_get TICKETS)
  _pm_set TICKETS "$(( ${n:-0} + 1 ))"
  if [[ -n "$grp" && -z "$(_pm_get GROUP)" ]]; then
    _pm_set GROUP "$grp"
    PM_GROUP_NAME="$grp"
  fi
}

# ---------------- one poll ----------------

_poll() {
  _refresh
  if ! _rotation_step; then
    _say "poll: claimed 0, in flight $INFLIGHT/$MAX_INFLIGHT, queue held while $PM_ROLE hands off"
    return 0
  fi
  _search "$JQL" "$TMP/queue.json"
  local claimed=0 left=0 waiting=0 hold=0 total key summary labels runs i grp rc
  total=$(jq 'length' "$TMP/queue.json")
  for (( i = 0; i < total; i++ )); do
    key=$(jq -r --argjson i "$i" '.[$i].key' "$TMP/queue.json")
    summary=$(jq -r --argjson i "$i" '.[$i].fields.summary // ""' "$TMP/queue.json")
    labels=$(jq -r --argjson i "$i" '.[$i].fields.labels // [] | .[]' "$TMP/queue.json")
    [[ "$key" =~ ^[A-Z][A-Z0-9_]+-[0-9]+$ ]] || { _say "skipping malformed key '$key'"; continue; }
    # A custom JQL may not exclude these; the labels are the source of truth.
    if printf '%s\n' "$labels" | grep -qxF -e "$CLAIMED" -e "$FAILED"; then
      continue
    fi
    runs=$(_ledger_get "$key" RUNS)
    if (( ${runs:-0} >= FAIL_CAP )); then
      if _swap "$key" "$FAILED" "$LABEL"; then
        _ledger_set "$key" STATE failed
        _say "$key back in the queue after ${runs} failed run(s) — labelled $FAILED, never claimed again"
      fi
      continue
    fi
    if (( INFLIGHT >= MAX_INFLIGHT )); then
      left=$((left + 1))
      continue
    fi
    # A ticket from another group than the PM's: rotate first, so the new
    # group starts with a fresh PM, or wait while the PM's group is in flight.
    # An ungrouped ticket never rotates; a PM that cannot rotate takes it as is.
    grp=$(_group_of "$TMP/queue.json" "$i")
    if [[ -f "$PM_SESSION" && -n "$grp" && -n "${PM_GROUP_NAME:-}" && "$grp" != "$PM_GROUP_NAME" ]]; then
      rc=0
      _rotation_try group "$PM_GROUP_NAME -> $grp" || rc=$?
      if (( rc == 0 )); then hold=1; break; fi
      if (( rc == 1 )); then waiting=$((waiting + 1)); continue; fi
    fi
    _swap "$key" "$CLAIMED" "$LABEL" || continue
    _ledger_set "$key" STATE pending
    _ledger_set "$key" PINGED 0
    _ledger_set "$key" PENDING_SINCE "$(date +%s)"
    _ledger_set "$key" SUMMARY "$summary"
    _ledger_incr "$key" CLAIMS
    claimed=$((claimed + 1))
    INFLIGHT=$((INFLIGHT + 1))
    _ping "$key"
    _pm_handed "$key" "$grp"
  done
  local tail=""
  (( left == 0 )) || tail=", $left left queued at the cap"
  (( waiting == 0 )) || tail+=", $waiting waiting for group ${PM_GROUP_NAME} to finish"
  (( hold == 0 )) || tail+=", queue held while $PM_ROLE hands off"
  _say "poll: claimed $claimed, in flight $INFLIGHT/$MAX_INFLIGHT$tail"
}

if (( ONCE )); then
  _poll
  exit 0
fi

_say "watching $REPO_NAME every ${INTERVAL}s (label $LABEL, max $MAX_INFLIGHT in flight)"
while :; do
  _poll
  sleep "$INTERVAL"
done
