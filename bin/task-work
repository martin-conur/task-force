#!/usr/bin/env bash
set -euo pipefail

# Canonical task-work (#237, epic #122 Phase 2).
#
# Was a dispatcher that exec'd $AW_ROOT/<impl>/bin/task-work. Those seven copies
# were 2124 lines whose variation ran along two orthogonal axes, not seven
# shapes: the TRACKER decides ref parsing, the usage synopsis, the .info key and
# the worker-prompt payload; the AGENT decides the extra flags, the preflight,
# the launch command and the completion message. So this body composes one
# module from each axis — lib/trackers/<tracker>.sh over _default.sh, and
# lib/agents/<agent>.sh — and a new combo is a pair of existing modules.
#
# Everything outside a hook call is the shared body, held in step by being one
# file rather than by nine drift-checker groups.

# Resolve own path through symlinks -> AW_ROOT.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src != /* ]] && src="$dir/$src"
done
BIN_DIR=$(cd -P "$(dirname "$src")" && pwd)
AW_ROOT=$(dirname "$BIN_DIR")

# shellcheck source=lib/detect-impl.sh
source "$AW_ROOT/lib/detect-impl.sh"
# shellcheck source=lib/zellij-tab.sh
source "$AW_ROOT/lib/zellij-tab.sh"
# shellcheck source=lib/worktree-create.sh
source "$AW_ROOT/lib/worktree-create.sh"
# shellcheck source=lib/repo-name.sh
source "$AW_ROOT/lib/repo-name.sh"
# shellcheck source=lib/ci-guard.sh
source "$AW_ROOT/lib/ci-guard.sh"

aw_parse_impl_flag "$@" || exit 1
IMPL=$(aw_detect_impl "$AW_PARSED_IMPL") || exit 1

# Compose the loadout. Resolve first, source second — see bin/task-done for why
# `source "$(aw_tracker_module …)" || exit 1` is not equivalent: the command
# substitution yields "" before `|| exit 1` is reached, and bash then buries the
# real diagnosis under a `: No such file or directory` naming this script.
AGENT="${IMPL%%-*}"
TRACKER="${IMPL##*-}"
# shellcheck source=lib/trackers/_default.sh
source "$AW_ROOT/lib/trackers/_default.sh"
TRACKER_MODULE=$(aw_tracker_module "$AW_ROOT" "$TRACKER") || exit 1
AGENT_MODULE=$(aw_agent_module "$AW_ROOT" "$AGENT") || exit 1
# shellcheck source=/dev/null
source "$TRACKER_MODULE"
# shellcheck source=/dev/null
source "$AGENT_MODULE"

set -- ${AW_REMAINING_ARGS[@]+"${AW_REMAINING_ARGS[@]}"}

usage() {
  echo "Usage:"
  aw_tracker_usage_synopsis
  cat <<EOF

Creates a git worktree + branch for a task and opens a new zellij tab
with a $(aw_agent_name) worker session. If a worktree for that slug already
exists, a 5-char hash is appended so multiple agents can work the same
task in parallel.
EOF
  aw_tracker_usage_notes
  cat <<EOF

Options:
  -b, --base BRANCH   Branch the PR will target (default: current branch at call time).
  -f, --from REF      Git ref to fork the new worktree's branch from. Defaults
                      to current HEAD. Use this to stack a PR on top of an
                      in-flight branch, or to spike off origin/main without
                      checking it out first. Accepts any ref \`git\` accepts
                      (branches, tags, SHAs, origin/foo).
      --no-launch     Create the worktree and open the tab at its directory,
                      but do NOT start $(aw_agent_name). Use this when you want to
                      pick the command/model interactively.
EOF
  aw_agent_usage_options
  echo "  -h, --help          Show this help."
  aw_agent_usage_env
  echo ""
  echo "Examples:"
  aw_tracker_usage_examples
  aw_agent_usage_examples
  exit "${1:-1}"
}

# ---------------- arg parsing ----------------
POSITIONAL=()
NO_LAUNCH=""
BASE_BRANCH_OVERRIDE=""
FROM_REF_OVERRIDE=""
AUTO_MODE=""
AUTO_SUBMIT_FLAG=""
AW_FLAG_SHIFT=0
aw_agent_init_flags

# The agent module gets first refusal on every token. A `case` arm cannot be
# injected by a function call, and kiro's -m / -a used to sit physically
# interleaved in this `case` (#237). The price is precedence: an agent flag
# would shadow a shared one on a name collision. There are none, and
# tests/task_work.bats pins that the shared flags behave identically under every
# agent module, so a future collision fails loudly instead of silently rebinding.
while [[ $# -gt 0 ]]; do
  if aw_agent_parse_flag "$@"; then shift "$AW_FLAG_SHIFT"; continue; fi
  case "$1" in
    -h|--help) usage 0 ;;
    -b|--base)
      [[ $# -ge 2 ]] || { echo "Error: --base requires a value" >&2; exit 1; }
      BASE_BRANCH_OVERRIDE="$2"; shift 2 ;;
    -f|--from)
      [[ $# -ge 2 ]] || { echo "Error: --from requires a value" >&2; exit 1; }
      FROM_REF_OVERRIDE="$2"; shift 2 ;;
    --no-launch) NO_LAUNCH="1"; shift ;;
    --auto) AUTO_MODE="1"; shift ;;
    --auto-submit) AUTO_SUBMIT_FLAG="1"; shift ;;
    --no-auto-submit) AUTO_SUBMIT_FLAG="0"; shift ;;
    --) shift; while [[ $# -gt 0 ]]; do POSITIONAL+=("$1"); shift; done ;;
    -*) echo "Error: unknown flag '$1'" >&2; usage 1 ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

aw_agent_validate_flags

[[ ${#POSITIONAL[@]} -lt 1 ]] && usage

# Sets AW_TASK_REF (may be empty) and AW_SLUG.
aw_tracker_parse_ref "${POSITIONAL[@]}"
TASK_REF="$AW_TASK_REF"
SLUG="$AW_SLUG"

[[ -z "$SLUG" ]] && { echo "Error: could not derive a slug from input" >&2; exit 1; }
SLUG="${SLUG:0:50}"

# Resolved now, not at the write: a module with no key must refuse before
# anything is created, not after the worktree exists.
INFO_KEY=$(aw_tracker_info_key) || exit 1

# ---------------- repo discovery ----------------
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Error: not in a git repo" >&2; exit 1; }
REPO_NAME=$(basename "$REPO_ROOT")

# The agent's preflight, before anything is created (#218) — that is its whole
# point. Sits mid-setup because it needs $REPO_ROOT and nothing after it.
aw_agent_preflight "$REPO_ROOT" "$IMPL" || exit 1
WORKTREE_BASE="${REPO_ROOT}/../${REPO_NAME}-worktrees"

# Capture base branch now, before the worktree is created
BASE_BRANCH="${BASE_BRANCH_OVERRIDE:-$(git rev-parse --abbrev-ref HEAD)}"
FROM_REF="${FROM_REF_OVERRIDE:-HEAD}"

if ! git rev-parse --verify --quiet "${FROM_REF}^{commit}" >/dev/null 2>&1; then
  echo "Error: --from ref '$FROM_REF' does not resolve to a commit" >&2
  exit 1
fi

BRANCH="task/${SLUG}"
WORKTREE_DIR="${WORKTREE_BASE}/${SLUG}"

# ---------------- worktree creation ----------------
# Auto-refresh: if local <base> is strictly behind origin/<base>, fork from
# origin/<base> instead of the stale local tip. Skipped when --from was given
# (that flag is the explicit user override). Local-ahead and diverged cases
# are left alone so unpushed work isn't silently bypassed.
if [[ -z "$FROM_REF_OVERRIDE" ]]; then
  git fetch origin "$BASE_BRANCH" --quiet 2>/dev/null || true
  if git rev-parse --verify --quiet "$BASE_BRANCH" >/dev/null 2>&1 \
     && git rev-parse --verify --quiet "origin/$BASE_BRANCH" >/dev/null 2>&1; then
    LOCAL_SHA=$(git rev-parse "$BASE_BRANCH")
    REMOTE_SHA=$(git rev-parse "origin/$BASE_BRANCH")
    if [[ "$LOCAL_SHA" != "$REMOTE_SHA" ]] \
       && git merge-base --is-ancestor "$LOCAL_SHA" "$REMOTE_SHA" 2>/dev/null; then
      echo "⚠ Local '$BASE_BRANCH' is behind 'origin/$BASE_BRANCH'. Forking from origin/$BASE_BRANCH."
      FROM_REF="origin/$BASE_BRANCH"
    fi
  fi
fi

# Worktree already exists for this slug? Spin up a parallel session with a hash
# suffix so multiple agents can iterate on the same task at the same time.
if [[ -d "$WORKTREE_DIR" ]]; then
  HASH=$(LC_ALL=C head -c 256 /dev/urandom | LC_ALL=C tr -dc 'a-z0-9' | head -c 5)
  SLUG="${SLUG}-${HASH}"
  BRANCH="task/${SLUG}"
  WORKTREE_DIR="${WORKTREE_BASE}/${SLUG}"
  echo "Existing worktree found — creating a parallel session: $SLUG"
fi

mkdir -p "$WORKTREE_BASE"
echo "Creating branch $BRANCH and worktree at $WORKTREE_DIR..."
aw_create_worktree "$WORKTREE_DIR" "$BRANCH" "$FROM_REF"

# Write task info so the worker and task-done can read it (stored outside the working tree)
INFO_FILE="${WORKTREE_BASE}/.${SLUG}.info"
printf 'BASE_BRANCH=%s\nSLUG=%s\n%s=%s\n' "$BASE_BRANCH" "$SLUG" "$INFO_KEY" "$TASK_REF" > "$INFO_FILE"

aw_tracker_post_worktree "$REPO_ROOT" "$SLUG" "$BRANCH" "$WORKTREE_DIR" "$TASK_REF"

# Install the commit-msg guard before the worker gets a shell (#194). GitHub
# honours a CI-skip marker anywhere in the head commit's message, so an agent
# that merely *quotes* one while describing another commit silently gets zero
# workflow runs — and reports "CI green" off an empty check list in good faith.
# A prompt warning is not enough: it has already happened to an agent that was
# correctly explaining the bug. Git shares one hooks dir across a repo's
# worktrees, so this protects every commit here, not just this worktree's.
aw_install_ci_guard_hook "$REPO_ROOT"

# ---------------- radio env injection ----------------
# Inject radio session env vars into the spawned command so the agent's
# SessionStart hook can register with the radio mailbox. The prefix is added
# to the cmd string passed to aw_launch_tab; VAR=val syntax in front of a
# command exports those vars to that command's environment only.
# Worktree-proof repo name for radio roles (#165 RC-2): basename(REPO_ROOT) is
# the worktree slug when task-work runs from a linked worktree, so derive the
# MAIN repo name via git-common-dir. Sanitized to the role charset (RC-6) so a
# dotted repo name can't produce an invalid role. Used for both the worker role
# and the injected PM address so the two stay symmetric across worktrees.
REPO_RADIO_NAME=$(aw_main_repo_name "$REPO_ROOT")
TASK_FORCE_ROLE_VALUE="worker-${REPO_RADIO_NAME}-${SLUG}"
RADIO_ENV_PREFIX="TASK_FORCE_ROLE=$(printf %q "$TASK_FORCE_ROLE_VALUE") ZELLIJ_TAB=$(printf %q "$SLUG") "
# The repo-scoped PM address (#165): `radio send --to pm` in the worker prompt
# is resolved by radio's shim; this injected value is the shim's registration-
# gated launch-time identity (step 1), so the ping reaches THIS repo's PM
# (pm-<reponame>) and never a different repo's PM tab.
RADIO_ENV_PREFIX+="TASK_FORCE_PM_ROLE=$(printf %q "pm-${REPO_RADIO_NAME}") "
# Radio's CR (auto-submit) wake-up, so PM pings process without a manual Enter
# (#128). It is its own setting, not a side effect of permission mode (#246):
# --auto implies it, and --auto-submit / --no-auto-submit set it either way,
# whichever order they come in. Without it radio keeps using LF — the human
# gate that protects a partially-typed prompt from an incoming `radio check`.
# Injected explicitly even when off: radio reads an *unset* value as "a repair —
# restore whatever this role had", which a fresh launch must never inherit.
#
# This is the body's, on every agent. An agent module reads AUTO_MODE only to
# decide its own launch flags (claude's --permission-mode auto); none may change
# what --auto does here (#237).
case "${AUTO_SUBMIT_FLAG:-}" in
  1) AUTO_SUBMIT="1" ;;
  0) AUTO_SUBMIT="" ;;
  *) AUTO_SUBMIT="${AUTO_MODE:-}" ;;
esac
if [[ -n "$AUTO_SUBMIT" ]]; then
  RADIO_ENV_PREFIX+="TASK_FORCE_AUTO_SUBMIT=1 "
else
  RADIO_ENV_PREFIX+="TASK_FORCE_AUTO_SUBMIT=0 "
fi

# ---------------- launch ----------------
# printf %q the user-supplied ref so `$var`, `$(...)`, backticks, and other
# shell metacharacters survive the `bash -ic` re-parse without being expanded by
# the child shell. Only the ref is quoted, never the whole payload: the agent
# wraps the payload in double quotes, inside which a %q-escaped space would
# arrive as a literal backslash. Mirrors RADIO_ENV_PREFIX, which already uses %q
# for its values. (#144 round-5 review.)
Q_TASK_REF=""
WORKER_PROMPT=""
if [[ -n "$TASK_REF" ]]; then
  Q_TASK_REF=$(printf %q "$TASK_REF")
  WORKER_PROMPT=$(aw_tracker_worker_prompt "$Q_TASK_REF")
fi

echo "Opening zellij tab '$SLUG'..."
# `set +H; ` prefix disables bash history expansion in the spawned `bash -ic`
# subshell — defends against `!` in a user-supplied ref (or future user-input
# passthroughs that grow on this code path) from being silently
# history-substituted before the agent / the worker prompt ever sees the arg.
# Critically, this prefix must come BEFORE $RADIO_ENV_PREFIX, not between it
# and the agent: `VAR=val cmd1; cmd2` scopes VAR=val to `cmd1` only, so putting
# `set +H` between the env prefix and the agent would attach the env
# assignments to the `set` builtin and they'd never reach the agent after the
# `;` (radio routing / model / AUTO_SUBMIT all dead). Mirrors the task-reviewer
# fix. (#144 round-4 review.)
if [[ -n "$NO_LAUNCH" ]]; then
  aw_launch_tab "$SLUG" "$WORKTREE_DIR" "" "${AUTO_MODE:-}"
else
  aw_launch_tab "$SLUG" "$WORKTREE_DIR" \
    "set +H; ${RADIO_ENV_PREFIX}$(aw_agent_launch_cmd "$Q_TASK_REF" "$WORKER_PROMPT")" \
    "${AUTO_MODE:-}"
fi

if [[ -n "$NO_LAUNCH" ]]; then
  echo "Tab opened at $WORKTREE_DIR (branch: $BRANCH, base: $BASE_BRANCH) — $(aw_agent_name) NOT launched (--no-launch)."
else
  echo "Started $(aw_agent_started_message) in $WORKTREE_DIR (branch: $BRANCH, base: $BASE_BRANCH)"
fi

# Persist the zellij tab_id of the worker's tab into $INFO_FILE so task-done
# can scope `zellij action close-tab-by-id` to *this* worker even if the
# radio session file's TAB_ID gets clobbered mid-life (#117). $INFO_FILE is
# owned by task-work / task-done and is never written by radio, so it stays
# authoritative regardless of any SessionStart/SessionEnd re-register churn
# inside the worker.
#
# Race-safe: aw_zellij_tab_id_by_name strips ⏸/▶/❓ paint prefixes off the
# zellij-side .name before matching against $SLUG, so a `radio busy` paint
# that fires between aw_launch_tab returning and this lookup (worker's
# SessionStart → first prompt) can't make the match miss (#117 review).
#
# A miss is reported here, on stderr and in radio's log, rather than surfacing
# hours later as task-done's "no tab id captured" (#242). It never aborts the
# launch — the worker is already running.
aw_record_tab_id "$SLUG" "$INFO_FILE" task-work
