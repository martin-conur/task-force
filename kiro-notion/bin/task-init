#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: task-init [--workflow | --commands | --hooks] [--force | --restore] [--help-ids]

Set up the current repo for the kiro-notion workflow:
  - Create .kiro/steering/notion-workflow.md from the bundled template
  - Install pm, planner, worker agents into .kiro/agents/
  - Merge radio PM↔worker messaging hooks into .kiro/agents/*.json

Scope (which categories of files to touch):
  --workflow       Workflow doc only
  --commands       Agents only (radio hooks ride along — see below)
  --hooks          Synonym for --commands. kiro-cli reads hooks from the
                   `hooks` field of each agent config, so the hooks and the
                   agents are the same set of files (#218). Kept so existing
                   scripts calling `task-init --hooks` keep working.
  (none)           All of the above (default)

Overwrite policy when a target file already exists:
  --force          Overwrite all targets (no prompt)
  --restore        Only fill missing targets; never touch existing files
  (TTY default)    Per-file prompt: [k]eep / [o]verwrite / [d]iff
  (non-TTY)        Silently keep existing files (script-safe)

The workflow doc is written between <!-- task-init:managed:start --> and
<!-- task-init:managed:end --> markers. A re-run replaces only that region, so
anything you add below the end marker survives --force. A doc predating those
markers is backed up to <doc>.bak before the markers are added.

--force and --restore are mutually exclusive.

Other:
  --help-ids       Print guide for finding Notion database IDs (no setup)
EOF
  exit 1
}

print_ids_guide() {
  cat <<'GUIDE'

How to find your Notion database IDs
─────────────────────────────────────
Notion IDs cannot be detected from the URL — you need an active Notion MCP
session to discover them. Here's how:

  1. Start a Kiro session in this project directory:
       kiro

  2. Ask Kiro: "Help me find my Notion database IDs"
     (Kiro will use the Notion MCP to fetch your board and extract the IDs)

  3. Paste the IDs into .kiro/steering/notion-workflow.md where marked:
       Tasks:    collection://<YOUR_TASKS_DATA_SOURCE_ID>
       Projects: collection://<YOUR_PROJECTS_DATA_SOURCE_ID>
       Board:    <YOUR_BOARD_PAGE_ID>

  Then ask Kiro to run the pm agent to verify everything works.

Tip: IDs look like UUID strings (e.g. 8a1b2c3d-...) or opaque alphanumeric
     slugs depending on how you access Notion. The MCP response will show
     them in <data-source url="collection://..."> attributes.
GUIDE
}

FORCE=false
RESTORE=false
SCOPE="all"
HELP_IDS=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force)    FORCE=true; shift ;;
    --restore)  RESTORE=true; shift ;;
    --workflow) SCOPE="workflow"; shift ;;
    --commands) SCOPE="commands"; shift ;;
    --hooks)    SCOPE="hooks"; shift ;;
    --help-ids) HELP_IDS=true; shift ;;
    -h|--help) usage ;;
    *) echo "Unknown option: $1"; usage ;;
  esac
done

if [[ "$HELP_IDS" == true ]]; then
  print_ids_guide
  exit 0
fi

if [[ "$FORCE" == true && "$RESTORE" == true ]]; then
  echo "Error: --force and --restore are mutually exclusive" >&2
  exit 2
fi

if [[ "$FORCE" == true ]]; then
  POLICY="force"
elif [[ "$RESTORE" == true ]]; then
  POLICY="restore"
elif [[ -t 0 ]]; then
  POLICY="prompt"
else
  POLICY="keep"
fi

# Resolve script path through symlinks
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ $src != /* ]] && src="$dir/$src"
done
SCRIPT_DIR=$(cd -P "$(dirname "$src")" && pwd)
TEMPLATE="$SCRIPT_DIR/../steering/notion-workflow.example.md"
LIB_DIR="$SCRIPT_DIR/../../lib"
# shellcheck source=lib/install-file.sh
. "$LIB_DIR/install-file.sh"
# region:require-jq-source
# shellcheck source=lib/require-jq.sh
. "$LIB_DIR/require-jq.sh"
# endregion:require-jq-source
# region:managed-region-source
# The workflow doc is installed through install_managed_file (#183), not
# install_file: a re-run refreshes only the task-init-owned region and leaves
# the user's own sections below the end marker alone.
# shellcheck source=lib/managed-region.sh
. "$LIB_DIR/managed-region.sh"
# endregion:managed-region-source

if [[ ! -f "$TEMPLATE" ]]; then
  echo "Error: template not found at $TEMPLATE"
  exit 1
fi

git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "Error: not in a git repo"; exit 1; }
REPO_ROOT=$(git rev-parse --show-toplevel)
TARGET="$REPO_ROOT/.kiro/steering/notion-workflow.md"

mkdir -p "$REPO_ROOT/.kiro/steering"

if [[ "$SCOPE" != "commands" && "$SCOPE" != "hooks" ]]; then
  INSTALL_POLICY="$POLICY" install_managed_file "$TEMPLATE" "$TARGET" "notion-workflow.md"
fi

if [[ "$SCOPE" != "workflow" ]]; then
  AGENTS_DIR="$REPO_ROOT/.kiro/agents"
  AGENTS_SRC=$(cd "$SCRIPT_DIR/.." && pwd)/agents
  mkdir -p "$AGENTS_DIR"
  for agent in "$AGENTS_SRC"/*.json; do
    agent_name=$(basename "$agent")
    agent_target="$AGENTS_DIR/$agent_name"
    INSTALL_POLICY="$POLICY" install_file "$agent" "$agent_target" "agent: $agent_name"
  done
fi

# region:radio-legacy-hook-guard
# True only for a .kiro/hooks/<name>.json that radio itself wrote: it carries
# both the "shellCommand" wrapper the pre-#218 installer used and a radio command
# inside it. A hook of the user's own in that directory is not ours to touch.
#
# Deliberately duplicated rather than shared, and guarded because of it: the kiro
# installers sweep these files when they install (#218/#222), lib/loadout-artifacts.sh
# removes them when a loadout is taken out (#219), and the installers do not
# source that lib. Extracting it would mean reworking a region that #220 and #221
# both queue against, so the copies stay — byte-identical and drift-guarded, so
# editing one without the other is caught instead of silently diverging, which is
# the failure that produced the ${TASK_FORCE_LOADOUT:-} drift #222 had to clean up.
_tf_is_legacy_radio_hook() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  grep -q '"shellCommand"' "$f" 2>/dev/null || return 1
  grep -q '"radio ' "$f" 2>/dev/null || return 1
  return 0
}
# endregion:radio-legacy-hook-guard

# -------- radio hooks (merged into the agent configs kiro-cli actually reads) -
# kiro-cli reads hooks from the `hooks` field of an *agent config*
# (<repo>/.kiro/agents/<name>.json), never from <repo>/.kiro/hooks/ — that
# directory is the Kiro *IDE*'s agent-hooks location, a different product.
# task-force wrote all three radio hooks there from the start, so none of them
# had ever run: no role registered, no state ever flipped, and every `radio
# send` to a kiro role degraded to "no session — message queued" (#218).
#
# Verified against kiro-cli 2.24.0: the accepted entry shape is {"command": …}
# (the shape its own bundled default.json uses); the {"trigger":…,"action":…}
# wire form task-force used to write is rejected by `kiro-cli agent validate`,
# as is the `agentStop` trigger name. The valid triggers are agentSpawn,
# userPromptSubmit, preToolUse, postToolUse and stop — and `stop` fires once
# per turn, which is what lets `radio ready` return the role to idle.
#
# The merge runs on every in-scope invocation regardless of the overwrite
# policy, deliberately: the hooks block is task-init-owned, the rest of the
# agent config is the user's. An existing kiro repo whose customized
# worker.json the policy keeps still has to come out of this with working
# hooks — that upgrade path is the whole point. Pre-existing non-radio hooks
# are preserved; the merge is idempotent (an entry is added only when no
# command on that trigger already starts with "radio ").
_radio_install_hooks() {
  local agents_dir="$REPO_ROOT/.kiro/agents"
  local loadout="kiro-notion"

# region:require-jq-call
  require_jq_1_6 || exit 1
# endregion:require-jq-call

# region:kiro-radio-hook-cmds
  # \${TASK_FORCE_LOADOUT:-$loadout} lets per-role launchers (e.g. task-reviewer
  # exporting TASK_FORCE_LOADOUT=reviewer) override the LOADOUT= field in the
  # session file without rewiring task-init. Plain task-pm / task-work sessions
  # don't set the env var, so they keep the loadout default ($loadout).
  local register_cmd="radio register --role \$TASK_FORCE_ROLE --tab \$ZELLIJ_TAB --repo \$(git rev-parse --show-toplevel 2>/dev/null) --agent kiro --loadout \${TASK_FORCE_LOADOUT:-$loadout}"
  # Plain `radio busy`, not `radio prompt-hook`. Not for the reason this line
  # used to give — kiro *does* inject hook stdout into the model's context
  # (confirmed by nonce control test, #218), so prompt-hook's inbox summary
  # would in fact land. Switching it is a notification-path behaviour change
  # deliberately held out of the registration fix; #221 carries that call.
  local busy_cmd="radio busy"
  # `radio ready` alone, not `radio ready && radio check`: the old pairing was
  # wired to the invalid `agentStop` trigger and never ran. `radio check`'s
  # listing is not what a hook should emit unprompted every turn, and whether
  # kiro honours Stop-hook block JSON (#163's drain) is a separate contract
  # from stdout injection and is untested — #221.
  local ready_cmd="radio ready"
# endregion:kiro-radio-hook-cmds

  if [[ ! -d "$agents_dir" ]]; then
    echo "Warning: $agents_dir does not exist; no agent to merge radio hooks into" >&2
    return 0
  fi

# region:kiro-radio-hooks-jq-merge
  local target tmp merged=0
  for target in "$agents_dir"/*.json; do
    [[ -f "$target" ]] || continue
    tmp="${target}.tmp.$$"
    if ! jq \
      --arg spawn "$register_cmd" \
      --arg ups   "$busy_cmd" \
      --arg stop  "$ready_cmd" \
      '
      def add_radio(arr; cmd):
        if (arr // []) | any((.command // "") | startswith("radio ")) then arr
        else (arr // []) + [{command: cmd}]
        end;
      # `agentStop` is not a valid kiro-cli trigger — an agent config carrying
      # one fails to load wholesale, taking every other hook with it. Drop any
      # radio-owned entry there; leave anything we did not write alone rather
      # than silently editing a key that is not ours.
      def drop_radio(arr):
        [ (arr // [])[] | select(((.command // "") | startswith("radio ")) | not) ];
      .hooks //= {}
      | .hooks.agentSpawn       = add_radio(.hooks.agentSpawn;       $spawn)
      | .hooks.userPromptSubmit = add_radio(.hooks.userPromptSubmit; $ups)
      | .hooks.stop             = add_radio(.hooks.stop;             $stop)
      | .hooks.agentStop        = drop_radio(.hooks.agentStop)
      | if (.hooks.agentStop | length) == 0 then del(.hooks.agentStop) else . end
      ' "$target" >"$tmp"; then
      rm -f "$tmp"
      echo "Warning: could not merge radio hooks into $target (invalid JSON?)" >&2
      continue
    fi
    mv -f "$tmp" "$target"
    merged=$((merged + 1))
  done
# endregion:kiro-radio-hooks-jq-merge

# region:kiro-radio-stray-hook-verify
  # A radio-prefixed command that isn't the one we install blocks add_radio from
  # installing the right one, so the repo would keep a stale hook while
  # task-init prints success — the same trap #172 found on the claude side.
  # Warn loudly rather than silently rewriting a command someone chose.
  local stray="" one
  for target in "$agents_dir"/*.json; do
    [[ -f "$target" ]] || continue
    one=$(jq -r \
      --arg spawn "$register_cmd" --arg ups "$busy_cmd" --arg stop "$ready_cmd" \
      --arg name "${target##*/}" '
      def stray(arr; evt; expected):
        [ (arr // [])[] | .command // ""
          | select(startswith("radio ") and . != expected)
          | "\($name) \(evt): \(.) — replace with: \(expected)" ];
      ( stray(.hooks.agentSpawn;       "agentSpawn";       $spawn)
      + stray(.hooks.userPromptSubmit; "userPromptSubmit"; $ups)
      + stray(.hooks.stop;             "stop";             $stop)
      ) | .[]
      ' "$target" 2>/dev/null || true)
    if [[ -n "$one" ]]; then stray+="$one"$'\n'; fi
  done
  if [[ -n "$stray" ]]; then
    {
      echo "WARNING: an agent config has a radio hook task-init could not upgrade:"
      printf '%s' "$stray" | sed '/./s/^/  /'
    } >&2
  fi
# endregion:kiro-radio-stray-hook-verify

  echo "✓ Merged radio hooks into $merged agent config(s) in $agents_dir"

# region:kiro-radio-legacy-hooks-sweep
  # Remove the inert .kiro/hooks/*.json files earlier task-init runs wrote.
  # Only the three radio-owned names, and only when the content is recognisably
  # ours — a user's own IDE hooks in that directory are not ours to delete.
  # Left behind, they are worse than clutter: the workflow doc points readers at
  # them as the thing that keeps the session file accurate (#218).
  local legacy_dir="$REPO_ROOT/.kiro/hooks" legacy swept=0
  for legacy in radio-register radio-busy radio-ready; do
    _tf_is_legacy_radio_hook "$legacy_dir/$legacy.json" || continue
    rm -f "$legacy_dir/$legacy.json"
    swept=$((swept + 1))
  done
  if (( swept > 0 )); then
    echo "✓ Removed $swept inert radio hook file(s) from $legacy_dir (kiro-cli never read them — #218)"
    if rmdir "$legacy_dir" 2>/dev/null; then
      echo "  (removed the now-empty $legacy_dir)"
    fi
  fi
# endregion:kiro-radio-legacy-hooks-sweep

  # Note: kiro has no session-end trigger (`stop` fires per turn, not on session
  # close), so the Claude SessionEnd → `radio unregister` beat still has no kiro
  # analog. The worker happy path stays covered by task-done, which invokes
  # `radio unregister --manual` before removing the worktree (#94); everything
  # else is `radio orphans` (#98).
}

if [[ "$SCOPE" != "workflow" ]]; then
  _radio_install_hooks
fi

print_ids_guide
