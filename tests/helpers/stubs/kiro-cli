#!/usr/bin/env bash
# Stub for kiro-cli — records all invocations, silently succeeds.
echo "kiro-cli $*" >> "${STUB_CALLS_DIR}/kiro-cli.calls"
echo "TASK_FORCE_ROLE=${TASK_FORCE_ROLE:-} ZELLIJ_TAB=${ZELLIJ_TAB:-} TASK_FORCE_PM_ROLE=${TASK_FORCE_PM_ROLE:-} TASK_FORCE_AUTO_SUBMIT=${TASK_FORCE_AUTO_SUBMIT:-}" >> "${STUB_CALLS_DIR}/kiro-cli.env"
# The radio home it was started with, `<unset>` when none (#262). Its own file:
# kiro-cli.env lines are matched whole by existing tests.
echo "TASK_FORCE_HOME=${TASK_FORCE_HOME-<unset>}" >> "${STUB_CALLS_DIR}/kiro-cli.home"

# The two probes the launchers make before a launch (#157). Modelled on
# kiro-cli 2.29.1; each knob reproduces the other state.
#   STUB_KIRO_NO_TUI=1                 a kiro-cli whose `chat` has no --tui flag
#   STUB_KIRO_TRUST_CONFIRM_DISABLED   the value of chat.disableTrustAllConfirmation;
#                                      unset means the setting is unset (exit 1)
# And the V3 upgrade-dialog probes (#257), modelled on 2.32.0, where an unset
# setting prints `null` and exits 0:
#   STUB_KIRO_ENGINE         the value of chat.agentEngine; unset prints null
#   STUB_KIRO_DEFAULT_ENGINE the engine `chat --help` calls the default (v2);
#                            empty drops the --agent-engine line, as on a
#                            kiro-cli with one engine
#   STUB_KIRO_AUTO_UPGRADE   the value of chat.enableAutoAgentUpgrade; unset
#                            prints null
if [[ "${1:-}" == chat && "${2:-}" == --help ]]; then
  echo "Usage: kiro-cli-chat chat [OPTIONS] [INPUT]"
  echo "      --agent <AGENT>"
  [[ -n "${STUB_KIRO_NO_TUI:-}" ]] || echo "      --tui"
  echo "      --legacy-ui"
  if [[ -n "${STUB_KIRO_DEFAULT_ENGINE-v2}" ]]; then
    echo "      --agent-engine <ENGINE>"
    echo "          Agent engine to use: \"v1\", \"${STUB_KIRO_DEFAULT_ENGINE-v2}\" (default), or \"v3\""
  fi
  exit 0
fi
if [[ "${1:-}" == settings && "${*: -1}" == chat.agentEngine ]]; then
  echo "cwd=$PWD" >> "${STUB_CALLS_DIR}/kiro-cli.engine-cwd"
  if [[ -n "${STUB_KIRO_ENGINE+x}" ]]; then echo "\"$STUB_KIRO_ENGINE\""; else echo null; fi
  exit 0
fi
if [[ "${1:-}" == settings && "${*: -1}" == chat.enableAutoAgentUpgrade ]]; then
  echo "cwd=$PWD" >> "${STUB_CALLS_DIR}/kiro-cli.upgrade-cwd"
  echo "${STUB_KIRO_AUTO_UPGRADE-null}"
  exit 0
fi
if [[ "${1:-}" == settings && "${*: -1}" == chat.disableTrustAllConfirmation ]]; then
  echo "cwd=$PWD" >> "${STUB_CALLS_DIR}/kiro-cli.settings-cwd"
  [[ -n "${STUB_KIRO_TRUST_CONFIRM_DISABLED+x}" ]] || {
    echo "error: No value associated with chat.disableTrustAllConfirmation" >&2; exit 1; }
  echo "$STUB_KIRO_TRUST_CONFIRM_DISABLED"
  exit 0
fi
exit 0
