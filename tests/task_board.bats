#!/usr/bin/env bats
# Tests for bin/task-board — rendering. Loadout detection and the refusal on
# non-local loadouts are tests/task_board_dispatcher.bats.

bats_load_library bats-support
bats_load_library bats-assert

load helpers/common

setup() {
  setup_repo
  mkdir -p "$MAIN_REPO/tasks"
  # task-board detects the loadout before it renders (#215), so the fixture has
  # to be a local-loadout repo, as every real caller's is.
  mkdir -p "$MAIN_REPO/.claude"
  touch "$MAIN_REPO/.claude/local-workflow.md"
  cd "$MAIN_REPO"
}

teardown() {
  teardown_all
}

# Helper: write a task file with frontmatter.
_task() {
  local path="$1" id="$2" title="$3" status="${4:-todo}" priority="${5:-P2}" pr="${6:-}"
  cat > "$path" <<EOF
---
id: $id
title: $title
status: $status
priority: $priority
tags: []
created: 2026-05-15
branch: ""
pr: "$pr"
---
EOF
}

# Helper: write a state.json entry.
_state_entry() {
  local slug="$1"
  mkdir -p "$MAIN_REPO/.git/task-force"
  printf '{"slug":"%s","branch":"task/%s","worktree":"/tmp/wt","started_at":"2026-05-15T12:00:00Z","task_file":""}\n' \
    "$slug" "$slug" >> "$MAIN_REPO/.git/task-force/state.json"
}

# ---------------------------------------------------------------------------
# Smoke
# ---------------------------------------------------------------------------

@test "writes tasks/_board.md with the autogenerated marker" {
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  assert [ -f "$MAIN_REPO/tasks/_board.md" ]
  run grep -F "AUTOGENERATED" "$MAIN_REPO/tasks/_board.md"
  assert_success
}

@test "board has three section headers" {
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run cat "$MAIN_REPO/tasks/_board.md"
  assert_output --partial "## Todo"
  assert_output --partial "## In Progress"
  assert_output --partial "## Done"
}

@test "empty tasks dir: each section shows _(none)_" {
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run grep -c "_(none)_" "$MAIN_REPO/tasks/_board.md"
  assert_output "3"
}

# ---------------------------------------------------------------------------
# Frontmatter-driven bucketing
# ---------------------------------------------------------------------------

@test "todo task lands in Todo section" {
  _task "$MAIN_REPO/tasks/001-foo.md" 001 "Foo" todo
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  awk '/^## Todo/{flag=1; next} /^## /{flag=0} flag' "$MAIN_REPO/tasks/_board.md" | grep -qF "Foo"
}

@test "in-progress task lands in In Progress section" {
  _task "$MAIN_REPO/tasks/002-bar.md" 002 "Bar" in-progress
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  awk '/^## In Progress/{flag=1; next} /^## /{flag=0} flag' "$MAIN_REPO/tasks/_board.md" | grep -qF "Bar"
}

@test "done task lands in Done section" {
  _task "$MAIN_REPO/tasks/003-baz.md" 003 "Baz" done
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  awk '/^## Done/{flag=1; next} /^## /{flag=0} flag' "$MAIN_REPO/tasks/_board.md" | grep -qF "Baz"
}

@test "tasks sorted by numeric id within each bucket" {
  _task "$MAIN_REPO/tasks/010-ten.md"  010 "Ten"  todo
  _task "$MAIN_REPO/tasks/002-two.md"  002 "Two"  todo
  _task "$MAIN_REPO/tasks/005-five.md" 005 "Five" todo
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  local order
  order=$(awk '/^## Todo/{flag=1; next} /^## /{flag=0} flag' "$MAIN_REPO/tasks/_board.md" \
    | grep -oE 'Two|Five|Ten' | tr '\n' ' ')
  assert_equal "$(echo "$order" | xargs)" "Two Five Ten"
}

# ---------------------------------------------------------------------------
# state.json overlay
# ---------------------------------------------------------------------------

@test "state.json overrides frontmatter and forces task into In Progress" {
  _task "$MAIN_REPO/tasks/001-foo.md" 001 "Foo" todo
  _state_entry "foo"
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  # Foo should be in the In Progress section, not Todo.
  ! awk '/^## Todo/{flag=1; next} /^## /{flag=0} flag' "$MAIN_REPO/tasks/_board.md" | grep -qF "Foo"
  awk '/^## In Progress/{flag=1; next} /^## /{flag=0} flag' "$MAIN_REPO/tasks/_board.md" | grep -qF "Foo"
}

@test "state.json entry without a matching task file is ignored" {
  _task "$MAIN_REPO/tasks/001-foo.md" 001 "Foo" done
  _state_entry "ghost-task"   # no tasks/NNN-ghost-task.md exists
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  # Foo is still in Done (state.json doesn't match its slug).
  awk '/^## Done/{flag=1; next} /^## /{flag=0} flag' "$MAIN_REPO/tasks/_board.md" | grep -qF "Foo"
  # ghost-task does not appear at all (task-board only reads task files).
  run grep -F "ghost-task" "$MAIN_REPO/tasks/_board.md"
  assert_failure
}

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

@test "each task row links to the task file" {
  _task "$MAIN_REPO/tasks/001-foo.md" 001 "Foo" todo
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run grep -F "(001-foo.md)" "$MAIN_REPO/tasks/_board.md"
  assert_success
}

@test "priority is shown next to the title" {
  _task "$MAIN_REPO/tasks/001-foo.md" 001 "Foo" todo P0
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run grep -F "P0" "$MAIN_REPO/tasks/_board.md"
  assert_success
}

@test "PR link is rendered when frontmatter pr: is set" {
  _task "$MAIN_REPO/tasks/001-foo.md" 001 "Foo" done P2 "https://example.com/pr/1"
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run grep -F "https://example.com/pr/1" "$MAIN_REPO/tasks/_board.md"
  assert_success
}

@test "README.md and _board.md in tasks/ are not treated as task files" {
  echo "# README" > "$MAIN_REPO/tasks/README.md"
  echo "stale board" > "$MAIN_REPO/tasks/_board.md"
  _task "$MAIN_REPO/tasks/001-foo.md" 001 "Foo" todo
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  # Only Foo is listed; README/board don't sneak in.
  run grep -cF "(001-foo.md)" "$MAIN_REPO/tasks/_board.md"
  assert_output "1"
  run grep -F "(README.md)" "$MAIN_REPO/tasks/_board.md"
  assert_failure
}

# ---------------------------------------------------------------------------
# Bounded Done section (#294)
# ---------------------------------------------------------------------------

# Helper: the Done section's lines (everything below "## Done").
_done_section() {
  awk '/^## Done/{flag=1; next} /^## /{flag=0} flag' "$MAIN_REPO/tasks/_board.md" | grep -v '^$'
}

# Helper: write done tasks 001..N.
_done_tasks() {
  local n="$1" i id
  for ((i = 1; i <= n; i++)); do
    id=$(printf '%03d' "$i")
    _task "$MAIN_REPO/tasks/${id}-done${i}.md" "$id" "Done$i" done
  done
}

@test "every open task is listed however many there are" {
  local i id
  for ((i = 1; i <= 15; i++)); do
    id=$(printf '%03d' "$i")
    _task "$MAIN_REPO/tasks/${id}-open${i}.md" "$id" "Open$i" todo
  done
  for ((i = 16; i <= 30; i++)); do
    _task "$MAIN_REPO/tasks/0${i}-wip${i}.md" "0$i" "Wip$i" in-progress
  done
  _done_tasks 0
  run "$TASK_BOARD" --repo "$MAIN_REPO" --done-limit 1
  assert_success
  run grep -c '^- \[' "$MAIN_REPO/tasks/_board.md"
  assert_output "30"
  run grep -F "older done" "$MAIN_REPO/tasks/_board.md"
  assert_failure
}

@test "done tasks are capped at 10 by default, newest first, with a count line" {
  _done_tasks 13
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run _done_section
  assert_line --index 0 --partial "Done13"
  assert_line --index 9 --partial "Done4"
  assert_line --index 10 "+ 3 older done tasks"
  assert_equal "${#lines[@]}" 11
  refute_output --partial "Done3]"
  refute_output --partial "Done1]"
}

@test "--done-limit sets the cap" {
  _done_tasks 5
  run "$TASK_BOARD" --repo "$MAIN_REPO" --done-limit 2
  assert_success
  run _done_section
  assert_equal "${#lines[@]}" 3
  assert_line --index 0 --partial "Done5"
  assert_line --index 1 --partial "Done4"
  assert_line --index 2 "+ 3 older done tasks"
}

@test "TASK_BOARD_DONE_LIMIT sets the cap, and --done-limit wins over it" {
  _done_tasks 5
  TASK_BOARD_DONE_LIMIT=3 run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run _done_section
  assert_equal "${#lines[@]}" 4
  assert_line --index 3 "+ 2 older done tasks"

  TASK_BOARD_DONE_LIMIT=3 run "$TASK_BOARD" --repo "$MAIN_REPO" --done-limit 4
  assert_success
  run _done_section
  assert_line --index 4 "+ 1 older done task"
}

@test "a leading-zero cap is read as decimal, not octal" {
  _done_tasks 12
  run "$TASK_BOARD" --repo "$MAIN_REPO" --done-limit 010
  assert_success
  run _done_section
  assert_line --index 10 "+ 2 older done tasks"
}

@test "--done-limit 0 lists no done task, only the count" {
  _done_tasks 4
  run "$TASK_BOARD" --repo "$MAIN_REPO" --done-limit 0
  assert_success
  run _done_section
  assert_output "+ 4 older done tasks"
}

@test "fewer done tasks than the cap: all listed, no count line" {
  _done_tasks 10
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run _done_section
  assert_equal "${#lines[@]}" 10
  run grep -F "older done" "$MAIN_REPO/tasks/_board.md"
  assert_failure
}

@test "a done task with a non-numeric id sorts last and is the first trimmed" {
  _done_tasks 3
  _task "$MAIN_REPO/tasks/abc-oddball.md" abc "Oddball" done
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run _done_section
  assert_line --index 0 --partial "Done3"
  assert_line --index 3 --partial "Oddball"

  run "$TASK_BOARD" --repo "$MAIN_REPO" --done-limit 3
  assert_success
  run _done_section
  refute_output --partial "Oddball"
  assert_line --index 3 "+ 1 older done task"
}

@test "a non-numeric cap is refused and the board is left untouched" {
  echo "previous board" > "$MAIN_REPO/tasks/_board.md"
  TASK_BOARD_DONE_LIMIT=lots run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_failure
  assert_output --partial "non-negative integer"
  run cat "$MAIN_REPO/tasks/_board.md"
  assert_output "previous board"
  run "$TASK_BOARD" --repo "$MAIN_REPO" --done-limit
  assert_failure
}

# ---------------------------------------------------------------------------
# Error cases
# ---------------------------------------------------------------------------

@test "fails outside a git repo with no --repo" {
  cd /tmp
  run "$TASK_BOARD"
  assert_failure
  assert_output --partial "not in a git repo"
}

@test "fails when tasks/ does not exist" {
  rm -rf "$MAIN_REPO/tasks"
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_failure
  assert_output --partial "does not exist"
}

# ---------------------------------------------------------------------------
# Idempotency
# ---------------------------------------------------------------------------

@test "running task-board twice produces identical output" {
  _task "$MAIN_REPO/tasks/001-foo.md" 001 "Foo" todo
  _task "$MAIN_REPO/tasks/002-bar.md" 002 "Bar" in-progress
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  cp "$MAIN_REPO/tasks/_board.md" /tmp/board_first.md
  run "$TASK_BOARD" --repo "$MAIN_REPO"
  assert_success
  run diff -q /tmp/board_first.md "$MAIN_REPO/tasks/_board.md"
  assert_success
  rm -f /tmp/board_first.md
}
